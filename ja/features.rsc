1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"本文へ移動"}],["$","$Lb",null,{"locale":"ja","copy":{"home":"概要","features":"機能","security":"プライバシーと管理","download":"ダウンロード","menu":"ナビゲーションを開く","closeMenu":"ナビゲーションを閉じる","primaryLabel":"メインナビゲーション","mobileLabel":"モバイルナビゲーション","homeLabel":"Artemis ホーム","languageLabel":"言語を選択","skipLink":"本文へ移動"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"詳しく見る"}],["$","h1",null,{"children":"最初のひらめきから、完成まで。"}],["$","p",null,{"children":"続けられる会話と、考えを役立つものに変えるツール。"}]]}],["$","section",null,{"className":"section-shell feature-list","children":[["$","article","01",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"01"}],["$","p",null,{"children":"プロジェクトと会話"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"仕事の流れを残す。"}],["$","p",null,{"children":"会話を保存、検索、アーカイブ、分岐。プロジェクトはローカルのファイルと結びつき、一時チャットは独立した作業に使えます。目標機能で長いタスクを進め、必要ならトークン予算も設定できます。"}]]}]]}],["$","article","02",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"02"}],["$","p",null,{"children":"ファイルと文書"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"その先も使える成果物を。"}],["$","p",null,{"children":"ファイルの編集、Markdown のプレビュー、付属プラグインでの Word、Excel、PowerPoint、PDF 作成に対応。基本内容を扱い、マクロ、アニメーション、複雑なレイアウトの完全保持は保証しません。"}]]}]]}],["$","article","03",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"03"}],["$","p",null,{"children":"コードとレビュー"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"変更を理解してから届ける。"}],["$","p",null,{"children":"直前のターン、ステージ済み変更、ブランチを比較。行内コメントや差分単位のステージングが可能です。ローカルで作業するか、明示的に独立したワークツリーを選べます。"}]]}]]}],["$","article","04",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"04"}],["$","p",null,{"children":"ターミナルとブラウザ"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"確かめる場所を、すぐそばに。"}],["$","p",null,{"children":"実際のターミナル、ウェブページ、ファイルを会話の隣で開けます。ブラウザ内のウェブコンテンツはデスクトップ API とローカルファイルから隔離されます。"}]]}]]}],["$","article","05",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"05"}],["$","p",null,{"children":"エージェントチーム"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"それぞれの部分に、集中を。"}],["$","p",null,{"children":"独立した作業を複数のエージェントで並行調査。指示、モデル、許可ツールを持つ専門役を作成し、@ で呼び出して進捗を確認できます。"}]]}]]}],["$","article","06",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"06"}],["$","p",null,{"children":"メッセージと協働"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"会話のある場所で、仕事を続ける。"}],["$","p",null,{"children":"WeCom、飛書 / Lark、Slack の個別チャットから依頼。Slack と飛書 / Lark のグループでは各自のボットが許可範囲で協働し、依頼者へ結果を返します。コンピュータと Artemis の稼働が必要です。"}]]}]]}],["$","article","07",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"07"}],["$","p",null,{"children":"自動化"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"日常の仕事に、決まった時間を。"}],["$","p",null,{"children":"一度だけ、一定間隔、毎日、毎週の予定をタイムゾーン付きで設定し、実行履歴を確認。Artemis の起動中に動作し、実行モードの自動化には明示的な許可が必要です。"}]]}]]}],["$","article","08",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"08"}],["$","p",null,{"children":"プラグインと接続サービス"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"必要になったら追加する。"}],["$","p",null,{"children":"プラグイン、スキル、コネクタ、MCP を一括管理。MCP サーバーを探し、アカウントや信頼するマーケットプレイスを追加できます。外部マーケットプレイスは標準では取得しません。"}]]}]]}],["$","article","09",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"09"}],["$","p",null,{"children":"モデルと使用量"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"自分に合うバランスを。"}],["$","p",null,{"children":"会話ごとにモデルを選び、互換サービスを接続。トークンとキャッシュの使用量を確認できます。Ultra モードは複雑なタスクで深い推論と並行作業を使い、使用量も増えます。"}]]}]]}],["$","article","10",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"10"}],["$","p",null,{"children":"記憶と言語"}]]}],["$","div",null,{"className":"feature-copy","children":["$Lc","$Ld"]}]]}]]}],"$Le","$Lf","$L10"]}],"$L11"]
