19:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"組み合わせて広がる力"}],["$","h2",null,{"children":"ひとつの方法。\nふたつの連携。"}],["$","p",null,{"children":"カスタムエージェントが専門性を担い、Agent Team がパソコン内の分担を整理。IM グループが、各メンバーの Artemis をつなぎます。"}]]}],["$","$L1e",null,{"mediaLabels":"$14:props:children:3:props:children:0:props:children:0:props:labels","label":"連携方法を選択","modes":[{"tab":"Agent Team と組み合わせる","title":"専門の役割を、ひとつのチームに。","body":"調査とレビューを独立したタスクに分け、カスタムエージェントが並行して進めます。主エージェントが調整と結果の整理を担当。各役割の進捗はチームパネルで確認できます。","steps":[{"title":"作業を分ける","body":"各部分で必要な成果を明確にします。"},{"title":"専門役を呼ぶ","body":"@ タスクブロック、または許可済みの自動呼び出しを使います。"},{"title":"並行して進める","body":"Agent Team で担当、状態、メッセージを確認します。"},{"title":"成果をまとめる","body":"各役割の結果を現在のタスクに戻します。"}],"alt":"並行タスクとメンバーの進捗を表示する Artemis Agent Team"},{"tab":"IM グループと組み合わせる","title":"グループのひとつの依頼を、チームで。","body":"ローカルの役割に自動呼び出しを許可すると、グループから届いたタスクに主エージェントが適用範囲内の役割を選べます。各パソコンが自分の担当を進め、結果を共通の会話へ返します。","steps":[{"title":"グループで依頼","body":"許可したボットに目標を伝えます。"},{"title":"メンバーへ割り当て","body":"適した作業をその人の Artemis に渡します。"},{"title":"手元で分担","body":"主エージェントが使える専門役を呼び、チームを組みます。"},{"title":"グループへ返信","body":"成果をまとめて依頼者に返し、連携を続けます。"}],"alt":"Artemis のネイティブ IM グループ連携とメンバーのタスク"}],"locale":"ja","rtl":false}]]}]}]
