:[["$","h3",null,{"children":"いつもの手順を、必要なときに。"}],["$","p",null,{"children":"設定でコマンド Hooks を確認して明示的に信頼します。Work と Codemode で動作し、Plan ではスキップ。プラグイン、Skills、MCP はリソースセンターで管理します。"}]]}],["$","article","インタラクティブなプラグイン",{"children":[["$","h3",null,{"children":"インタラクティブなプラグイン"}],["$","p",null,{"children":"隔離されたパネルとツールを追加できます。Design プラグインがインストールされ利用可能な場合、文書作成、履歴、取り消し、復元を利用できます。プロジェクトのファイルは明示的なインポートが必要です。"}]]}]]}]]}],["$","section",null,{"id":"office","className":"section-shell feature-story","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"Office · DOCX / XLSX / PPTX / CSV"}],"$Le","$Lf","$L10","$L11","$L12"]}],"$L13","$L14"]}],"$L15","$L16","$L17","$L18","$L19","$L1a","$L1b"]}],"$L1c"]]
