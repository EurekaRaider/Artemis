e:["$","section",null,{"id":"custom-agents","className":"section-shell feature-story agents-story","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"カスタムエージェント"}],["$","h2",null,{"children":"あなたの進め方を、\n頼れる役割に。"}],["$","p",null,{"children":"調査、レビュー、執筆のための専用エージェントを作成。役割と成果物を一度定義すれば、選んだプロジェクトで繰り返し呼び出せます。"}],["$","dl",null,{"className":"agent-settings","children":[["$","div","専用の指示",{"children":[["$","dt",null,{"children":"専用の指示"}],["$","dd",null,{"children":"責任、作業方法、期待する成果物を定めます。"}]]}],["$","div","モデルと思考",{"children":[["$","dt",null,{"children":"モデルと思考"}],["$","dd",null,{"children":"モデルと思考レベルを指定するか、会話の設定を引き継ぎます。"}]]}],["$","div","ツールとプロジェクト",{"children":[["$","dt",null,{"children":"ツールとプロジェクト"}],["$","dd",null,{"children":"使えるツールと、役割を適用するプロジェクトを選びます。"}]]}],["$","div","呼び出し方",{"children":[["$","dt",null,{"children":"呼び出し方"}],["$","dd",null,{"children":"デスクトップで @ 指定するか、適したタスクで主エージェントが自動選択できるようにします。"}]]}]]}]]}],["$","div",null,{"className":"agent-roles","children":[["$","p",null,{"className":"journey-label","children":"たとえば、こんな役割分担"}],[["$","article","調査担当",{"children":[["$","span",null,{"className":"role-monogram","aria-hidden":"true","children":["0",1]}],["$","div",null,{"children":[["$","h3",null,{"children":"調査担当"}],["$","p",null,{"children":"資料と出典を整理し、根拠のある結論をまとめます。"}]]}],["$","span",null,{"className":"role-mention","aria-hidden":"true","children":"@"}]]}],["$","article","レビュー担当",{"children":[["$","span",null,{"className":"role-monogram","aria-hidden":"true","children":["0",2]}],["$","div",null,{"children":[["$","h3",null,{"children":"レビュー担当"}],["$","p",null,{"children":"論拠や見落としを確認し、具体的な改善案を示します。"}]]}],["$","span",null,{"className":"role-mention","aria-hidden":"true","children":"@"}]]}]],["$","p",null,{"className":"roles-caption","children":"ひとつの役割を、さまざまなタスクで活かせます。"}]]}]]}]
f:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"組み合わせて広がる力"}],["$","h2",null,{"children":"ひとつの方法。\nふたつの連携。"}],["$","p",null,{"children":"カスタムエージェントが専門性を担い、Agent Team がパソコン内の分担を整理。IM グループが、各メンバーの Artemis をつなぎます。"}]]}],["$","$L13",null,{"label":"連携方法を選択","modes":[{"tab":"Agent Team と組み合わせる","title":"専門の役割を、ひとつのチームに。","body":"調査とレビューを独立したタスクに分け、カスタムエージェントが並行して進めます。主エージェントが調整と結果の整理を担当。各役割の進捗はチームパネルで確認できます。","steps":[{"title":"作業を分ける","body":"各部分で必要な成果を明確にします。"},{"title":"専門役を呼ぶ","body":"@ タスクブロック、または許可済みの自動呼び出しを使います。"},{"title":"並行して進める","body":"Agent Team で担当、状態、メッセージを確認します。"},{"title":"成果をまとめる","body":"各役割の結果を現在のタスクに戻します。"}],"alt":"並行タスクとメンバーの進捗を表示する Artemis Agent Team"},{"tab":"IM グループと組み合わせる","title":"グループのひとつの依頼を、チームで。","body":"ローカルの役割に自動呼び出しを許可すると、グループから届いたタスクに主エージェントが適用範囲内の役割を選べます。各パソコンが自分の担当を進め、結果を共通の会話へ返します。","steps":[{"title":"グループで依頼","body":"許可したボットに目標を伝えます。"},{"title":"メンバーへ割り当て","body":"適した作業をその人の Artemis に渡します。"},{"title":"手元で分担","body":"主エージェントが使える専門役を呼び、チームを組みます。"},{"title":"グループへ返信","body":"成果をまとめて依頼者に返し、連携を続けます。"}],"alt":"Artemis のネイティブ IM グループ連携とメンバーのタスク"}],"rtl":false}]]}]}]
10:["$","section",null,{"className":"section-shell supporting-features","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"デスクトップの作業空間"}],["$","h2",null,{"children":"最後まで仕上げる道具も、\nチームのそばに。"}]]}],["$","div",null,{"className":"supporting-grid","children":[["$","article","01",{"children":[["$","p",null,{"className":"eyebrow","children":"プロジェクトと会話"}],["$","h3",null,{"children":"仕事の流れを残す。"}],["$","p",null,{"children":"会話を保存、検索、アーカイブ、分岐。プロジェクトはローカルのファイルと結びつき、一時チャットは独立した作業に使えます。目標機能で長いタスクを進め、必要ならトークン予算も設定できます。"}]]}],["$","article","02",{"children":[["$","p",null,{"className":"eyebrow","children":"ファイルと文書"}],["$","h3",null,{"children":"その先も使える成果物を。"}],["$","p",null,{"children":"ファイルの編集、Markdown のプレビュー、付属プラグインでの Word、Excel、PowerPoint、PDF 作成に対応。基本内容を扱い、マクロ、アニメーション、複雑なレイアウトの完全保持は保証しません。"}]]}],["$","article","03",{"children":[["$","p",null,{"className":"eyebrow","children":"コードとレビュー"}],["$","h3",null,{"children":"変更を理解してから届ける。"}],["$","p",null,{"children":"直前のターン、ステージ済み変更、ブランチを比較。行内コメントや差分単位のステージングが可能です。ローカルで作業するか、明示的に独立したワークツリーを選べます。"}]]}],["$","article","04",{"children":[["$","p",null,{"className":"eyebrow","children":"ターミナルとブラウザ"}],["$","h3",null,{"children":"確かめる場所を、すぐそばに。"}],["$","p",null,{"children":"実際のターミナル、ウェブページ、ファイルを会話の隣で開けます。ブラウザ内のウェブコンテンツはデスクトップ API とローカルファイルから隔離されます。"}]]}],["$","article","07",{"children":[["$","p",null,{"className":"eyebrow","children":"自動化"}],["$","h3",null,{"children":"日常の仕事に、決まった時間を。"}],["$","p",null,{"children":"一度だけ、一定間隔、毎日、毎週の予定をタイムゾーン付きで設定し、実行履歴を確認。Artemis の起動中に動作し、実行モードの自動化には明示的な許可が必要です。"}]]}],["$","article","08",{"children":[["$","p",null,{"className":"eyebrow","children":"プラグインと接続サービス"}],["$","h3",null,{"children":"必要になったら追加する。"}],["$","p",null,{"children":"プラグイン、スキル、コネクタ、MCP を一括管理。MCP サーバーを探し、アカウントや信頼するマーケットプレイスを追加できます。外部マーケットプレイスは標準では取得しません。"}]]}],["$","article","09",{"children":[["$","p",null,{"className":"eyebrow","children":"モデルと使用量"}],["$","h3",null,{"children":"自分に合うバランスを。"}],["$","p",null,{"children":"会話ごとにモデルを選び、互換サービスを接続。トークンとキャッシュの使用量を確認できます。Ultra モードは複雑なタスクで深い推論と並行作業を使い、使用量も増えます。"}]]}],["$","article","10",{"children":[["$","p",null,{"className":"eyebrow","children":"記憶と言語"}],["$","h3",null,{"children":"繰り返しを減らし、続きを自然に。"}],["$","p",null,{"children":"プロジェクトの知識や指示を再利用。スキルやツール設定を選んで取り込み、認証情報を黙ってコピーしません。14 言語とシステム言語、アラビア語の右から左の表示に対応します。"}]]}]]}]]}]
