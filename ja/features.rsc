a:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"本文へ移動"}],["$","$Lc",null,{"locale":"ja","copy":{"home":"概要","features":"機能","security":"プライバシーと管理","download":"ダウンロード","menu":"ナビゲーションを開く","closeMenu":"ナビゲーションを閉じる","primaryLabel":"メインナビゲーション","mobileLabel":"モバイルナビゲーション","homeLabel":"Artemis ホーム","languageLabel":"言語を選択","skipLink":"本文へ移動"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"section-shell features-hero","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"つながる。一緒につくる。"}],["$","h1",null,{"children":"ひとつのメッセージから、\nみんなの成果へ。"}]]}],["$","p",null,{"className":"features-lead","children":"いつもの IM で依頼し、パソコンの Artemis に任せる。自分の進め方をカスタムエージェントにして、Agent Team とグループ連携でそれぞれの得意を持ち寄れます。"}],["$","nav",null,{"className":"feature-jumps","aria-label":"機能を見る","children":[["$","a","IM 接続",{"href":"#im-connect","children":["IM 接続",["$","span",null,{"aria-hidden":"true","children":"↓"}]]}],["$","a","IM グループ連携",{"href":"#im-groups","children":["IM グループ連携",["$","span",null,{"aria-hidden":"true","children":"↓"}]]}],["$","a","カスタムエージェント",{"href":"#custom-agents","children":["カスタムエージェント",["$","span",null,{"aria-hidden":"true","children":"↓"}]]}],["$","a","組み合わせて使う",{"href":"#work-together","children":["組み合わせて使う",["$","span",null,{"aria-hidden":"true","children":"↓"}]]}]]}]]}],["$","section",null,{"id":"im-connect","className":"section-shell feature-story connect-story","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"IM 接続"}],["$","h2",null,{"children":"デスクを離れても、\n仕事はつながる。"}],["$","p",null,{"children":"自分のボットへのメッセージから、プロジェクトの確認やファイルの作業を依頼。結果を受け取り、同じ会話で質問を続けられます。確認事項への回答や本人の承認にも対応します。"}],["$","dl",null,{"className":"im-platforms","children":[["$","div","Feishu / Lark",{"children":[["$","dt",null,{"children":"Feishu / Lark"}],["$","dd",null,{"children":"Feishu は QR 接続とストリーミングカード返信に対応。Lark は手動で設定できます。"}]]}],["$","div","Slack",{"children":[["$","dt",null,{"children":"Slack"}],["$","dd",null,{"children":"ボットとの個別メッセージでローカル作業を依頼し、チャンネルでも連携できます。"}]]}]]}],["$","p",null,{"className":"story-note","children":"受信には、パソコンがスリープしておらず、Artemis と接続が有効である必要があります。"}]]}],["$","div",null,{"className":"connection-journey","children":[["$","p",null,{"className":"journey-label","children":"メッセージから、手元の作業へ"}],["$","blockquote",null,{"children":"「プロジェクトを確認して、今日の進捗をまとめて。」"}],["$","ol",null,{"children":[["$","li","メッセージで依頼",{"children":[["$","span",null,{"className":"journey-number","aria-hidden":"true","children":1}],["$","div",null,{"children":[["$","h3",null,{"children":"メッセージで依頼"}],["$","p",null,{"children":"使い慣れたツールから始めます。"}]]}]]}],["$","li","自分のパソコンで作業",{"children":[["$","span",null,{"className":"journey-number","aria-hidden":"true","children":2}],["$","div",null,{"children":[["$","h3",null,{"children":"自分のパソコンで作業"}],["$","p",null,{"children":"許可したプロジェクト、ファイル、ツールを使います。"}]]}]]}],["$","li","同じ会話に戻る",{"children":[["$","span",null,{"className":"journey-number","aria-hidden":"true","children":3}],["$","div",null,{"children":[["$","h3",null,{"children":"同じ会話に戻る"}],["$","p",null,{"children":"進捗と結果を受け取り、続けて相談できます。"}]]}]]}]]}],["$","span",null,{"className":"journey-signature","children":"Artemis"}]]}]]}],["$","section",null,{"id":"im-groups","className":"group-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"group-story-heading story-copy","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"IM グループ連携"}],["$","h2",null,{"children":"ひとつの会話に、\nそれぞれの得意を。"}]]}],["$","p",null,{"children":"既存の Slack チャンネルや Feishu / Lark グループで、各メンバーが自分のボットと Artemis を接続。適した人に仕事を渡し、その人が許可したデスクトップの機能を活かせます。"}]]}],["$","div",null,{"className":"group-story-detail","children":[["$","div",null,{"className":"group-points","children":[[["$","article","相手を指定して依頼",{"children":[["$","h3",null,{"children":"相手を指定して依頼"}],["$","p",null,{"children":"グループでボットを @ 指定するか、Artemis からメンバーにタスクを割り当てます。"}]]}],["$","article","それぞれの範囲で作業",{"children":[["$","h3",null,{"children":"それぞれの範囲で作業"}],["$","p",null,{"children":"プロジェクト、フォルダー、ファイル、操作の権限はパソコンごとに設定します。"}]]}],["$","article","依頼元へ結果を返す",{"children":[["$","h3",null,{"children":"依頼元へ結果を返す"}],["$","p",null,{"children":"委任した結果は元のグループに戻り、依頼者にメンションして次の作業へつなぎます。"}]]}]],["$","p",null,{"className":"story-note","children":"自動委任にはボット間の許可と往復通信の検証が必要です。人が次のボットを手動で @ 指定することもできます。"}]]}],["$","figure",null,{"className":"product-frame","children":["$","$Ld",null,{"src":"/images/im-group-chat.png","alt":"Artemis のグループ会話とメンバーパネル","width":"1440","height":"850","priority":false,"sizes":"(max-width: 700px) calc(100vw - 32px), (max-width: 1200px) calc(100vw - 48px), 1080px","unoptimized":true}]}]]}]]}]}],"$Le","$Lf","$L10","$L11"]}],"$L12"]
