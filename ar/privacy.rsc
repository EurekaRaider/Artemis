1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"الانتقال إلى المحتوى"}],["$","$Lb",null,{"locale":"ar","copy":{"home":"نظرة عامة","features":"الميزات","security":"الخصوصية والتحكم","download":"تنزيل","menu":"فتح التنقل","closeMenu":"إغلاق التنقل","primaryLabel":"التنقل الرئيسي","mobileLabel":"التنقل على الهاتف","homeLabel":"الرئيسية في Artemis","languageLabel":"اختيار اللغة","skipLink":"الانتقال إلى المحتوى"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"سارية من 19 سبتمبر 2026 · المشغّل: Eureka Raider"}],["$","h1",null,{"children":"سياسة الخصوصية"}],["$","p",null,{"children":"مساحة العمل محفوظة على جهازك. استخدام الحسابات والنماذج المتصلة يشمل أيضًا الخدمات التي تختارها. توضح السياسة هذه الحدود."}]]}],["$","article",null,{"className":"section-shell legal-document","aria-label":"سياسة الخصوصية","children":[[["$","section","1. النطاق والمشغّل",{"children":[["$","h2",null,{"children":"1. النطاق والمشغّل"}],[["$","p","يقدم Eureka Raider مساحة عمل الذكاء الاصطناعي Artemis وهذا الموقع. تشمل السياسة معالجة المعلومات عبر Artemis وتكامل Google والدعم. للخدمات الخارجية سياساتها الخاصة أيضًا.",{"children":"يقدم Eureka Raider مساحة عمل الذكاء الاصطناعي Artemis وهذا الموقع. تشمل السياسة معالجة المعلومات عبر Artemis وتكامل Google والدعم. للخدمات الخارجية سياساتها الخاصة أيضًا."}]]]}],["$","section","2. المعلومات المتاحة",{"children":[["$","h2",null,{"children":"2. المعلومات المتاحة"}],[["$","p","نعالج المطالبات والملفات والمشاريع ونتائج الأدوات والمحادثات التي تقدمها أو تسمح بالوصول إليها. تتطلب الخدمات المختارة إعدادات النموذج وبيانات اعتماد الحسابات.",{"children":"نعالج المطالبات والملفات والمشاريع ونتائج الأدوات والمحادثات التي تقدمها أو تسمح بالوصول إليها. تتطلب الخدمات المختارة إعدادات النموذج وبيانات اعتماد الحسابات."}],["$","p","عند ربط Google نصل إلى معرّف الحساب والبريد والملف الشخصي لتحديد الحساب. حسب الموصل والأذونات قد يشمل ذلك نصوص Gmail ورؤوسها ومستلميها ومرفقاتها ومسوداتها وتصنيفاتها؛ ومحتوى Google Drive وبياناته الوصفية بما فيها المستندات والجداول والعروض؛ وتقاويم Google Calendar وأحداثه والمشاركين والتوفر. تعرض شاشة موافقة Google الأذونات المطلوبة.",{"children":"عند ربط Google نصل إلى معرّف الحساب والبريد والملف الشخصي لتحديد الحساب. حسب الموصل والأذونات قد يشمل ذلك نصوص Gmail ورؤوسها ومستلميها ومرفقاتها ومسوداتها وتصنيفاتها؛ ومحتوى Google Drive وبياناته الوصفية بما فيها المستندات والجداول والعروض؛ وتقاويم Google Calendar وأحداثه والمشاركين والتوفر. تعرض شاشة موافقة Google الأذونات المطلوبة."}]]]}],["$","section","3. الغرض من أذونات Google",{"children":[["$","h2",null,{"children":"3. الغرض من أذونات Google"}],[["$","p","تتيح Gmail البحث والقراءة والصياغة والإرسال والتنظيم وفق طلبك. وتتيح Drive البحث عن الملفات وقراءتها وإنشاءها وتحديثها، وCalendar الاطلاع على الأحداث وإنشاءها وتعديلها وحذفها. تعتمد الإجراءات على الأدوات المتاحة وتعليماتك.",{"children":"تتيح Gmail البحث والقراءة والصياغة والإرسال والتنظيم وفق طلبك. وتتيح Drive البحث عن الملفات وقراءتها وإنشاءها وتحديثها، وCalendar الاطلاع على الأحداث وإنشاءها وتعديلها وحذفها. تعتمد الإجراءات على الأدوات المتاحة وتعليماتك."}],["$","p","الاتصال اختياري. تُستخدم بيانات Google للوظائف المطلوبة، لا للإعلان أو التنميط الإعلاني أو قرارات الائتمان، ولا تُباع.",{"children":"الاتصال اختياري. تُستخدم بيانات Google للوظائف المطلوبة، لا للإعلان أو التنميط الإعلاني أو قرارات الائتمان، ولا تُباع."}]]]}],["$","section","4. النماذج والجهات المستلمة",{"children":[["$","h2",null,{"children":"4. النماذج والجهات المستلمة"}],[["$","p","قد تدخل رسائل Google وملفاته وتقاويمه ونتائج الأدوات ذات الصلة ضمن المحادثة المرسلة إلى مزود الذكاء الاصطناعي الذي تضبطه. التخزين المحلي لا يعني المعالجة المحلية وحدها. اختر مزودًا وإعدادات احتفاظ مناسبة للمعلومات الحساسة.",{"children":"قد تدخل رسائل Google وملفاته وتقاويمه ونتائج الأدوات ذات الصلة ضمن المحادثة المرسلة إلى مزود الذكاء الاصطناعي الذي تضبطه. التخزين المحلي لا يعني المعالجة المحلية وحدها. اختر مزودًا وإعدادات احتفاظ مناسبة للمعلومات الحساسة."}],"$Lc","$Ld"]]}],"$Le","$Lf","$L10","$L11","$L12"],"$L13","$L14","$L15"]}]]}],"$L16"]
17:I["9fb86276be8f",[],"default",1]
c:["$","p","تتلقى الأدوات والإضافات البيانات اللازمة للإجراءات المصرّح بها. إرسال الرسائل والمشاركة والنشر يكشف المحتوى للمستلمين المختارين أيضًا. يتواصل جهازك مع Google والخدمات المحددة؛ لا يتلقى الموقع رموز تفويض Google.",{"children":"تتلقى الأدوات والإضافات البيانات اللازمة للإجراءات المصرّح بها. إرسال الرسائل والمشاركة والنشر يكشف المحتوى للمستلمين المختارين أيضًا. يتواصل جهازك مع Google والخدمات المحددة؛ لا يتلقى الموقع رموز تفويض Google."}]
d:["$","p","يقتصر نقل بيانات Google على الوظائف المطلوبة بموافقتك أو الضرورات الأمنية أو المتطلبات القانونية أو انتقال الملكية بعد موافقتك الصريحة المسبقة.",{"children":"يقتصر نقل بيانات Google على الوظائف المطلوبة بموافقتك أو الضرورات الأمنية أو المتطلبات القانونية أو انتقال الملكية بعد موافقتك الصريحة المسبقة."}]
e:["$","section","5. واجهات Google والاستخدام المحدود",{"children":[["$","h2",null,{"children":"5. واجهات Google والاستخدام المحدود"}],[["$","p","يخضع الاستخدام والنقل لسياسة Google API Services User Data Policy ومتطلبات Limited Use.",{"children":"يخضع الاستخدام والنقل لسياسة Google API Services User Data Policy ومتطلبات Limited Use."}],["$","p","لا تُستخدم بيانات Google لتطوير نماذج الذكاء الاصطناعي أو التعلم الآلي العامة أو تحسينها أو تدريبها. معالجة المحتوى للرد على طلبك تختلف عن التدريب. استخدم مزودين وإعدادات تحترم هذه القيود.",{"children":"لا تُستخدم بيانات Google لتطوير نماذج الذكاء الاصطناعي أو التعلم الآلي العامة أو تحسينها أو تدريبها. معالجة المحتوى للرد على طلبك تختلف عن التدريب. استخدم مزودين وإعدادات تحترم هذه القيود."}],["$","p","لا نقرأ بيانات Google بصورة روتينية. يقتصر الوصول البشري على موافقتك الصريحة لبيانات محددة أو تحقيقات أمنية لازمة أو واجبات قانونية أو عمليات داخلية مجمّعة تسمح بها Google.",{"children":"لا نقرأ بيانات Google بصورة روتينية. يقتصر الوصول البشري على موافقتك الصريحة لبيانات محددة أو تحقيقات أمنية لازمة أو واجبات قانونية أو عمليات داخلية مجمّعة تسمح بها Google."}]]]}]
f:["$","section","6. التخزين والأمان والاحتفاظ",{"children":[["$","h2",null,{"children":"6. التخزين والأمان والاحتفاظ"}],[["$","p","تُحفظ مساحة العمل والمحادثات على جهازك. تُشفّر بيانات اعتماد Google بحماية النظام، ويُرفض حفظها إن غابت الحماية. لا يعني ذلك تشفير كل الملفات والمحادثات. احمِ الجهاز والنسخ الاحتياطية والحسابات.",{"children":"تُحفظ مساحة العمل والمحادثات على جهازك. تُشفّر بيانات اعتماد Google بحماية النظام، ويُرفض حفظها إن غابت الحماية. لا يعني ذلك تشفير كل الملفات والمحادثات. احمِ الجهاز والنسخ الاحتياطية والحسابات."}],["$","p","تبقى بيانات الاعتماد حتى الفصل أو حذف البيانات المحلية المعنية. وقد تبقى المحادثات والنتائج بعد الفصل حتى تحذفها. يطبق المزودون سياسات احتفاظهم، ولا نعد بمدة ثابتة لنسخهم.",{"children":"تبقى بيانات الاعتماد حتى الفصل أو حذف البيانات المحلية المعنية. وقد تبقى المحادثات والنتائج بعد الفصل حتى تحذفها. يطبق المزودون سياسات احتفاظهم، ولا نعد بمدة ثابتة لنسخهم."}]]]}]
10:["$","section","7. الفصل والإلغاء والحذف",{"children":[["$","h2",null,{"children":"7. الفصل والإلغاء والحذف"}],[["$","p","فصل موصل Google في Artemis يزيل بيانات الاعتماد المحلية. لإلغاء أذونات Google احذف Artemis من اتصالات الأطراف الخارجية في حساب Google. الفصل المحلي وحده لا يلغي إذن Google ولا يحذف المحتوى السابق.",{"children":"فصل موصل Google في Artemis يزيل بيانات الاعتماد المحلية. لإلغاء أذونات Google احذف Artemis من اتصالات الأطراف الخارجية في حساب Google. الفصل المحلي وحده لا يلغي إذن Google ولا يحذف المحتوى السابق."}],["$","p","احذف المحادثات والملفات المصدرة والبيانات غير اللازمة، والنسخ الاحتياطية بصورة منفصلة. لا يحذف الفصل أصول Gmail أو Drive أو Calendar. أدرها لدى Google واطلب من مزود النموذج أو الإضافة حذف نسخه.",{"children":"احذف المحادثات والملفات المصدرة والبيانات غير اللازمة، والنسخ الاحتياطية بصورة منفصلة. لا يحذف الفصل أصول Gmail أو Drive أو Calendar. أدرها لدى Google واطلب من مزود النموذج أو الإضافة حذف نسخه."}],["$","p","للمساعدة في الوصول أو التصحيح أو الحذف اتصل بالدعم أدناه. يمكننا معالجة ما ترسله للدعم، لكن لا نحذف عن بُعد ملفات لا توجد إلا على جهازك. لا ترسل كلمات المرور أو مفاتيح API أو الرموز أو البريد الحساس إلى قائمة الدعم.",{"children":"للمساعدة في الوصول أو التصحيح أو الحذف اتصل بالدعم أدناه. يمكننا معالجة ما ترسله للدعم، لكن لا نحذف عن بُعد ملفات لا توجد إلا على جهازك. لا ترسل كلمات المرور أو مفاتيح API أو الرموز أو البريد الحساس إلى قائمة الدعم."}]]]}]
11:["$","section","8. الموقع والدعم",{"children":[["$","h2",null,{"children":"8. الموقع والدعم"}],[["$","p","يستضيف GitHub Pages هذا الموقع. قد تعالج الاستضافة عناوين IP ومعلومات المتصفح وبيانات تقنية لتقديم الموقع وحمايته. تستخدم التنزيلات استضافة إصدارات GitHub.",{"children":"يستضيف GitHub Pages هذا الموقع. قد تعالج الاستضافة عناوين IP ومعلومات المتصفح وبيانات تقنية لتقديم الموقع وحمايته. تستخدم التنزيلات استضافة إصدارات GitHub."}],["$","p","يختار الموقع لغة العرض وفق تفضيلات المتصفح. تُحفظ اللغة التي تختارها يدويًا في التخزين المحلي للمتصفح ولها الأولوية. يمكنك تغييرها من قائمة اللغات أو مسح بيانات الموقع لإزالة الاختيار المحفوظ.",{"children":"يختار الموقع لغة العرض وفق تفضيلات المتصفح. تُحفظ اللغة التي تختارها يدويًا في التخزين المحلي للمتصفح ولها الأولوية. يمكنك تغييرها من قائمة اللغات أو مسح بيانات الموقع لإزالة الاختيار المحفوظ."}],["$","p","يُستخدم بريدك وما تقدمه للرد على طلبك. العنوان قائمة بريدية على Google Groups؛ تُعالج الرسائل فيها وقد يراها أعضاء المجموعة. شارك الحد الأدنى اللازم فقط.",{"children":"يُستخدم بريدك وما تقدمه للرد على طلبك. العنوان قائمة بريدية على Google Groups؛ تُعالج الرسائل فيها وقد يراها أعضاء المجموعة. شارك الحد الأدنى اللازم فقط."}]]]}]
12:["$","section","9. التغييرات والتواصل",{"children":[["$","h2",null,{"children":"9. التغييرات والتواصل"}],[["$","p","ننشر التحديثات بتاريخ سريان جديد. إذا تجاوز استخدام Google التفويض السابق، نوضح ذلك ونحصل على الموافقة مسبقًا. لأسئلة الخصوصية أو الحذف تواصل مع Eureka Raider أدناه.",{"children":"ننشر التحديثات بتاريخ سريان جديد. إذا تجاوز استخدام Google التفويض السابق، نوضح ذلك ونحصل على الموافقة مسبقًا. لأسئلة الخصوصية أو الحذف تواصل مع Eureka Raider أدناه."}]]]}]
