14:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"قدرات أوسع حين تجتمع"}],["$","h2",null,{"children":"أسلوب واحد.\nوطريقتان للتعاون."}],["$","p",null,{"children":"يضيف الوكلاء المخصصون الخبرة. وينسّق Agent Team العمل على حاسوب واحد. وتربط مجموعات IM بين Artemis لدى الأعضاء المختلفين."}]]}],["$","$L19",null,{"label":"اختر طريقة التعاون","modes":[{"tab":"مع Agent Team","title":"اجعل أدوارك المتخصصة فريقًا واحدًا.","body":"قسّم البحث والمراجعة إلى مهام مستقلة لوكلاء مخصصين يعملون بالتوازي. ينسّق الوكيل الرئيسي التقدم ويجمع النتائج، ويمكنك متابعة كل دور في لوحة الفريق.","steps":[{"title":"قسّم العمل","body":"حدّد النتيجة المطلوبة من كل جزء."},{"title":"استدعِ المتخصصين","body":"استخدم كتل المهام مع @ أو الاستدعاء التلقائي الذي سمحت به."},{"title":"تقدّم بالتوازي","body":"تابع التكليفات والحالات والرسائل في Agent Team."},{"title":"اجمع النتائج","body":"أعد مساهمة كل دور إلى المهمة الحالية."}],"alt":"Agent Team في Artemis مع مهام متوازية وتقدم الأعضاء"},{"tab":"مع مجموعات IM","title":"طلب واحد في المجموعة. وفريق يعمل خلفه.","body":"فعّل الاستدعاء التلقائي للأدوار المحلية. عندما تصل مهمة المجموعة إلى Artemis، يستطيع الوكيل الرئيسي اختيار تلك الأدوار ضمن نطاق المشروع. ينجز كل حاسوب جزأه ويعيد النتائج إلى الحوار المشترك.","steps":[{"title":"اطلب في المجموعة","body":"أعطِ الهدف لروبوت مخوّل."},{"title":"أسند إلى عضو","body":"أرسل الجزء المناسب إلى Artemis لدى ذلك العضو."},{"title":"نسّق محليًا","body":"يستدعي الوكيل الرئيسي المتخصصين المتاحين وينظّم فريقه المحلي."},{"title":"أجب في المجموعة","body":"اجمع النتائج وردّ على صاحب الطلب وتابع التعاون."}],"alt":"التعاون الأصلي في مجموعات IM ومهام الأعضاء في Artemis"}],"locale":"ar","rtl":true}]]}]}]
