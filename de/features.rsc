19:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"Gemeinsam mehr erreichen"}],["$","h2",null,{"children":"Eine Methode.\nZwei Wege der Zusammenarbeit."}],["$","p",null,{"children":"Eigene Agenten bringen Fachwissen ein. Agent Team koordiniert Aufgaben auf einem Computer. IM-Gruppen verbinden die Artemis-Arbeitsplätze verschiedener Mitglieder."}]]}],["$","$L20",null,{"label":"Zusammenarbeit auswählen","modes":[{"tab":"Mit Agent Team","title":"Aus deinen Fachrollen wird ein Team.","body":"Teile Recherche und Prüfung in eigenständige Aufgaben, die eigene Agenten parallel bearbeiten. Der Hauptagent koordiniert den Fortschritt und führt die Ergebnisse zusammen. Verfolge jede Rolle in der Teamansicht.","steps":[{"title":"Arbeit aufteilen","body":"Lege das Ergebnis jedes Teilauftrags fest."},{"title":"Fachrollen aufrufen","body":"Nutze @-Aufgabenblöcke oder den von dir erlaubten automatischen Aufruf."},{"title":"Parallel vorankommen","body":"Verfolge Aufgaben, Status und Nachrichten in Agent Team."},{"title":"Ergebnisse zusammenführen","body":"Bringe die Beiträge der Rollen in die aktuelle Aufgabe zurück."}],"alt":"Artemis Agent Team mit parallelen Aufgaben und Fortschritten der Mitglieder"},{"tab":"Mit IM-Gruppen","title":"Eine Anfrage in der Gruppe. Ein Team dahinter.","body":"Erlaube den automatischen Aufruf lokaler Rollen. Erreicht eine Gruppenaufgabe Artemis, kann der Hauptagent passende Rollen innerhalb des Projektumfangs auswählen. Jeder Computer übernimmt seinen Teil und sendet Ergebnisse in das gemeinsame Gespräch.","steps":[{"title":"In der Gruppe anfragen","body":"Gib einem autorisierten Bot ein Ziel."},{"title":"Passend zuweisen","body":"Sende den passenden Teil an das Artemis des jeweiligen Mitglieds."},{"title":"Lokal koordinieren","body":"Der Hauptagent ruft verfügbare Fachrollen auf und organisiert sein lokales Team."},{"title":"In der Gruppe antworten","body":"Führe Ergebnisse zusammen, antworte der anfragenden Person und arbeitet weiter."}],"alt":"Native IM-Gruppenarbeit und Mitgliederaufgaben in Artemis"}],"locale":"de","rtl":false}]]}]}]
