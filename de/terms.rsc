c:["$","section","5. Dritte und Kosten",{"children":[["$","h2",null,{"children":"5. Dritte und Kosten"}],[["$","p","Google, Anbieter, Plugins und Dienste haben eigene Bedingungen, Verfügbarkeit, Kontingente und Richtlinien. Du trägst ihre Kosten. Google-Verbindung bedeutet keine Empfehlung durch Google. Änderungen oder abgelaufene Freigaben können Funktionen beeinflussen.",{"children":"Google, Anbieter, Plugins und Dienste haben eigene Bedingungen, Verfügbarkeit, Kontingente und Richtlinien. Du trägst ihre Kosten. Google-Verbindung bedeutet keine Empfehlung durch Google. Änderungen oder abgelaufene Freigaben können Funktionen beeinflussen."}]]]}]
d:["$","section","6. Inhalte und Datenschutz",{"children":[["$","h2",null,{"children":"6. Inhalte und Datenschutz"}],[["$","p","Deine Rechte bleiben bestehen; du erlaubst die für gewünschte Aufgaben notwendige Verarbeitung, ohne Eigentum an Eureka Raider zu übertragen. Zugriff, Übertragung, Aufbewahrung, Löschung und Google-API-Grenzen erläutert die Datenschutzerklärung.",{"children":"Deine Rechte bleiben bestehen; du erlaubst die für gewünschte Aufgaben notwendige Verarbeitung, ohne Eigentum an Eureka Raider zu übertragen. Zugriff, Übertragung, Aufbewahrung, Löschung und Google-API-Grenzen erläutert die Datenschutzerklärung."}]]]}]
e:["$","section","7. Verfügbarkeit und Haftung",{"children":[["$","h2",null,{"children":"7. Verfügbarkeit und Haftung"}],[["$","p","Soweit gesetzlich zulässig, wird Artemis nach Verfügbarkeit ohne Garantie für unterbrechungsfreien Betrieb, Eignung oder Fehlerfreiheit bereitgestellt. Im selben Rahmen haftet Eureka Raider nicht für mittelbare oder Folgeschäden, auch durch Dritte oder ungeprüfte KI-Aktionen. Nicht abdingbare Haftung und gesetzliche Verbraucherrechte bleiben unberührt.",{"children":"Soweit gesetzlich zulässig, wird Artemis nach Verfügbarkeit ohne Garantie für unterbrechungsfreien Betrieb, Eignung oder Fehlerfreiheit bereitgestellt. Im selben Rahmen haftet Eureka Raider nicht für mittelbare oder Folgeschäden, auch durch Dritte oder ungeprüfte KI-Aktionen. Nicht abdingbare Haftung und gesetzliche Verbraucherrechte bleiben unberührt."}]]]}]
f:["$","section","8. Beendigung und Änderungen",{"children":[["$","h2",null,{"children":"8. Beendigung und Änderungen"}],[["$","p","Du kannst jederzeit aufhören, Konten trennen und lokale Daten löschen. Widerruf löscht nicht automatisch Dateien oder bereits übertragene Daten. Wir können Funktionen ändern oder einstellen sowie eigene Dienste wegen Missbrauchs oder gesetzlicher Pflichten einschränken.",{"children":"Du kannst jederzeit aufhören, Konten trennen und lokale Daten löschen. Widerruf löscht nicht automatisch Dateien oder bereits übertragene Daten. Wir können Funktionen ändern oder einstellen sowie eigene Dienste wegen Missbrauchs oder gesetzlicher Pflichten einschränken."}],["$","p","Neue Bedingungen werden hier mit Datum veröffentlicht; wesentliche Änderungen stehen darin oder in Versionsinformationen. Fragen bitte an die folgende Adresse.",{"children":"Neue Bedingungen werden hier mit Datum veröffentlicht; wesentliche Änderungen stehen darin oder in Versionsinformationen. Fragen bitte an die folgende Adresse."}]]]}]
