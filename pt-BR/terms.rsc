d:["$","p","Google, provedores, plugins e serviços têm termos, disponibilidade, cotas e políticas próprios. As cobranças são sua responsabilidade. Conectar Google não implica endosso ao Artemis. Mudanças e autorizações expiradas podem afetar funções.",{"children":"Google, provedores, plugins e serviços têm termos, disponibilidade, cotas e políticas próprios. As cobranças são sua responsabilidade. Conectar Google não implica endosso ao Artemis. Mudanças e autorizações expiradas podem afetar funções."}]
e:["$","section","6. Conteúdo e privacidade",{"children":[["$","h2",null,{"children":"6. Conteúdo e privacidade"}],[["$","p","Seus direitos permanecem; você autoriza o processamento necessário às funções pedidas, sem transferir propriedade a Eureka Raider. Consulte a política sobre acesso, transferência, retenção, exclusão e restrições Google API.",{"children":"Seus direitos permanecem; você autoriza o processamento necessário às funções pedidas, sem transferir propriedade a Eureka Raider. Consulte a política sobre acesso, transferência, retenção, exclusão e restrições Google API."}]]]}]
f:["$","section","7. Disponibilidade e responsabilidade",{"children":[["$","h2",null,{"children":"7. Disponibilidade e responsabilidade"}],[["$","p","Nos limites legais, Artemis é fornecido conforme disponibilidade, sem garantia de continuidade, adequação ou ausência de erros. Nesses limites, Eureka Raider não responde por perdas indiretas ou consequentes, inclusive de terceiros ou ações de IA não revisadas. Responsabilidades e direitos do consumidor que não podem ser excluídos permanecem.",{"children":"Nos limites legais, Artemis é fornecido conforme disponibilidade, sem garantia de continuidade, adequação ou ausência de erros. Nesses limites, Eureka Raider não responde por perdas indiretas ou consequentes, inclusive de terceiros ou ações de IA não revisadas. Responsabilidades e direitos do consumidor que não podem ser excluídos permanecem."}]]]}]
10:["$","section","8. Encerramento e mudanças",{"children":[["$","h2",null,{"children":"8. Encerramento e mudanças"}],[["$","p","Você pode parar, desconectar contas e apagar dados locais quando quiser. Revogar não exclui automaticamente arquivos ou dados já enviados. Podemos mudar ou encerrar funções ou limitar serviços próprios por abuso ou obrigação legal.",{"children":"Você pode parar, desconectar contas e apagar dados locais quando quiser. Revogar não exclui automaticamente arquivos ou dados já enviados. Podemos mudar ou encerrar funções ou limitar serviços próprios por abuso ou obrigação legal."}],["$","p","Novos termos serão publicados aqui com data; mudanças relevantes serão indicadas nos termos ou nas informações da versão. Dúvidas podem ser enviadas ao contato abaixo.",{"children":"Novos termos serão publicados aqui com data; mudanças relevantes serão indicadas nos termos ou nas informações da versão. Dúvidas podem ser enviadas ao contato abaixo."}]]]}]
