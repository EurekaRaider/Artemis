10:["$","p",null,{"children":"Projetos e histórico ficam localmente. Instruções, arquivos e resultados relevantes podem ser enviados ao modelo ou serviço escolhido."}]
11:["$","article","02",{"className":"bento-card glass-panel","data-reveal":true,"children":[["$","div",null,{"className":"bento-card-top","children":[["$","p",null,{"className":"kicker","children":"Credenciais"}],["$","span",null,{"className":"mono-index","children":"02"}]]}],["$","h2",null,{"className":"title","children":"Protegidas pelo sistema operacional."}],["$","p",null,{"children":"Chaves API e credenciais usam criptografia do sistema. Sem proteção disponível, segredos não são salvos. Isso não criptografa todos os arquivos e conversas."}]]}]
