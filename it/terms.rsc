13:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"className":"section-shell footer-grid","children":[["$","div",null,{"className":"footer-brand","children":[["$","a",null,{"className":"brand","href":"/it/","children":[["$","$L14",null,{"className":"brand-mark","src":"/images/artemis-icon.png","alt":"","width":"48","height":"48","unoptimized":true}],["$","span",null,{"children":"Artemis"}]]}],["$","p",null,{"children":"Un po’ più di spazio per ciò che conta."}]]}],["$","div",null,{"className":"footer-column","children":[["$","h2",null,{"children":"Scopri Artemis"}],["$","a",null,{"href":"/it/","children":"Panoramica"}],["$","a",null,{"href":"/it/features/","children":"Funzioni"}],["$","a",null,{"href":"/it/security/","children":"Privacy e controllo"}],["$","a",null,{"href":"/it/download/","children":"Scarica"}]]}],["$","div",null,{"className":"footer-column","children":[["$","h2",null,{"children":"Privacy e assistenza"}],["$","a",null,{"href":"/it/privacy/","children":"Informativa sulla privacy"}],["$","a",null,{"href":"/it/terms/","children":"Termini di servizio"}],["$","a",null,{"href":"mailto:artemis-support@googlegroups.com","children":"Contatta l’assistenza"}]]}]]}],["$","div",null,{"className":"section-shell footer-bottom","children":[["$","span",null,{"children":["© ",2026," Eureka Raider"]}],["$","span",null,{"children":"Per lavorare con cura."}]]}]]}]
