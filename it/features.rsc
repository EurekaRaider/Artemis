12:["$","section",null,{"id":"custom-agents","className":"section-shell feature-story agents-story","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"Agenti personalizzati"}],["$","h2",null,{"children":"Il tuo modo di lavorare.\nRuoli su cui contare."}],["$","p",null,{"children":"Crea agenti dedicati a ricerca, revisione o scrittura. Definisci una volta responsabilità e risultati attesi, poi richiamali nei progetti che scegli."}],["$","dl",null,{"className":"agent-settings","children":[["$","div","Istruzioni dedicate",{"children":[["$","dt",null,{"children":"Istruzioni dedicate"}],["$","dd",null,{"children":"Definisci responsabilità, metodi e risultati attesi."}]]}],["$","div","Modello e ragionamento",{"children":[["$","dt",null,{"children":"Modello e ragionamento"}],["$","dd",null,{"children":"Scegli modello e livello di ragionamento o eredita quelli della conversazione."}]]}],["$","div","Strumenti e progetti",{"children":[["$","dt",null,{"children":"Strumenti e progetti"}],["$","dd",null,{"children":"Seleziona gli strumenti disponibili e i progetti a cui si applica il ruolo."}]]}],["$","div","Modalità di invocazione",{"children":[["$","dt",null,{"children":"Modalità di invocazione"}],["$","dd",null,{"children":"Usa @ sul desktop o consenti all’agente principale di scegliere il ruolo automaticamente."}]]}]]}]]}],["$","div",null,{"className":"agent-roles","children":[["$","p",null,{"className":"journey-label","children":"Alcuni ruoli che puoi creare"}],[["$","article","Ricercatore",{"children":[["$","span",null,{"className":"role-monogram","aria-hidden":"true","children":["0",1]}],["$","div",null,{"children":[["$","h3",null,{"children":"Ricercatore"}],["$","p",null,{"children":"Organizzare le fonti e formulare conclusioni sostenute da prove."}]]}],["$","span",null,{"className":"role-mention","aria-hidden":"true","children":"@"}]]}],["$","article","Revisore",{"children":[["$","span",null,{"className":"role-monogram","aria-hidden":"true","children":["0",2]}],["$","div",null,{"children":[["$","h3",null,{"children":"Revisore"}],["$","p",null,{"children":"Verificare le argomentazioni, trovare lacune e proporre miglioramenti concreti."}]]}],["$","span",null,{"className":"role-mention","aria-hidden":"true","children":"@"}]]}]],["$","p",null,{"className":"roles-caption","children":"Uno stesso ruolo può contribuire a molte attività."}]]}]]}]
13:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"Più possibilità insieme"}],["$","h2",null,{"children":"Un metodo.\nDue modi di collaborare."}],["$","p",null,{"children":"Gli agenti personalizzati portano competenze. Agent Team coordina il lavoro su un computer. I gruppi IM collegano gli Artemis dei diversi membri."}]]}],["$","$L18",null,{"label":"Scegli una modalità di collaborazione","modes":[{"tab":"Con Agent Team","title":"I tuoi specialisti diventano una squadra.","body":"Dividi ricerca e revisione in attività indipendenti per agenti personalizzati che lavorano in parallelo. L’agente principale coordina i progressi e raccoglie i risultati. Segui ogni ruolo nel pannello del team.","steps":[{"title":"Dividi il lavoro","body":"Definisci il risultato di ogni parte."},{"title":"Chiama gli specialisti","body":"Usa blocchi di attività @ o l’invocazione automatica che hai autorizzato."},{"title":"Procedi in parallelo","body":"Segui incarichi, stati e messaggi in Agent Team."},{"title":"Riunisci i risultati","body":"Riporta i contributi di ogni ruolo nell’attività corrente."}],"alt":"Agent Team di Artemis con attività parallele e progressi dei membri"},{"tab":"Con i gruppi IM","title":"Una richiesta nel gruppo. Una squadra al lavoro.","body":"Abilita l’invocazione automatica dei ruoli locali. Quando un’attività del gruppo arriva ad Artemis, l’agente principale può selezionarli nell’ambito del progetto. Ogni computer svolge la propria parte e restituisce i risultati alla conversazione comune.","steps":[{"title":"Chiedi nel gruppo","body":"Comunica un obiettivo a un bot autorizzato."},{"title":"Assegna a un membro","body":"Invia la parte adatta al suo Artemis."},{"title":"Coordina sul posto","body":"L’agente principale chiama gli specialisti disponibili e organizza il team locale."},{"title":"Rispondi nel gruppo","body":"Raccogli i risultati, rispondi al richiedente e continua a collaborare."}],"alt":"Collaborazione nativa nei gruppi IM e attività dei membri in Artemis"}],"rtl":false}]]}]}]
14:["$","section",null,{"className":"section-shell supporting-features","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"Uno spazio di lavoro completo"}],["$","h2",null,{"children":"Gli strumenti per finire,\naccanto alla squadra."}]]}],["$","div",null,{"className":"supporting-grid","children":[["$","article","01",{"children":[["$","p",null,{"className":"eyebrow","children":"Progetti e conversazioni"}],["$","h3",null,{"children":"Mantieni il filo del lavoro."}],["$","p",null,{"children":"Salva, cerca, archivia e dirama conversazioni. Le attività restano vicine ai file; le chat temporanee hanno uno spazio proprio. Gli obiettivi guidano lavori lunghi, con budget di token facoltativi."}]]}],["$","article","02",{"children":[["$","p",null,{"className":"eyebrow","children":"File e documenti"}],["$","h3",null,{"children":"Crea risultati utilizzabili."}],["$","p",null,{"children":"Modifica file, visualizza Markdown e crea contenuti Word, Excel, PowerPoint o PDF con i plugin inclusi. Si conservano contenuti di base, senza garantire macro, animazioni o impaginazioni complesse."}]]}],["$","article","03",{"children":[["$","p",null,{"className":"eyebrow","children":"Codice e revisione"}],["$","h3",null,{"children":"Comprendi le modifiche prima di consegnarle."}],["$","p",null,{"children":"Confronta l’ultimo turno, le modifiche nell’indice o un ramo. Aggiungi commenti e prepara singoli blocchi. Lavora nella copia locale o scegli esplicitamente un albero di lavoro isolato."}]]}],["$","article","04",{"children":[["$","p",null,{"className":"eyebrow","children":"Terminale e browser"}],["$","h3",null,{"children":"Tieni vicine le verifiche."}],["$","p",null,{"children":"Apri un vero terminale, pagine web e file accanto alla conversazione. Il browser separa il web dalle API del desktop e dai file locali."}]]}],["$","article","07",{"children":[["$","p",null,{"className":"eyebrow","children":"Automazioni"}],["$","h3",null,{"children":"Dai un ritmo alla quotidianità."}],["$","p",null,{"children":"Programma attività singole, a intervalli, giornaliere o settimanali con fuso orario e cronologia. Funzionano con Artemis aperto; la modalità Esegui richiede un’autorizzazione esplicita."}]]}],["$","article","08",{"children":[["$","p",null,{"className":"eyebrow","children":"Plugin e servizi"}],["$","h3",null,{"children":"Aggiungi ciò che serve."}],["$","p",null,{"children":"Gestisci plugin, competenze, connettori e MCP in un solo posto. Scopri server, collega account o aggiungi un catalogo fidato. I cataloghi esterni non vengono consultati per impostazione predefinita."}]]}],["$","article","09",{"children":[["$","p",null,{"className":"eyebrow","children":"Modelli e utilizzo"}],["$","h3",null,{"children":"Trova il tuo equilibrio."}],["$","p",null,{"children":"Scegli modelli per conversazione, collega fornitori compatibili e controlla token e cache. Ultra offre ragionamento approfondito e lavoro parallelo per attività complesse, con consumi maggiori."}]]}],["$","article","10",{"children":[["$","p",null,{"className":"eyebrow","children":"Memoria e lingue"}],["$","h3",null,{"children":"Meno ripetizioni. Più continuità."}],["$","p",null,{"children":"Conserva conoscenze e istruzioni del progetto. Importa selettivamente competenze e configurazioni senza copiare credenziali di nascosto. Usa 14 lingue, quella del sistema e il layout da destra a sinistra in arabo."}]]}]]}]]}]
