[
  [
    "normal|[data-artemis-component=\"data-surface\"], [data-artemis-component=\"data-stat\"], [data-artemis-component=\"data-heatmap\"]",
    {
      "box-sizing": "border-box",
      "min-inline-size": "0",
      "color": "var(--artemis-color-text-primary)",
      "font-family": "var(--artemis-typography-body-family)",
      "font-size": "var(--artemis-typography-body-size)"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-surface\"]",
    {
      "display": "flex",
      "flex": "1 1 auto",
      "flex-direction": "column",
      "inline-size": "100%",
      "min-block-size": "0",
      "background": "var(--artemis-color-canvas)"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-surface\"] > [data-part=\"header\"], [data-artemis-component=\"data-surface\"] > [data-part=\"toolbar\"], [data-artemis-component=\"data-surface\"] > [data-part=\"content\"]",
    { "min-inline-size": "0" }
  ],
  [
    "normal|[data-artemis-component=\"data-surface\"] > [data-part=\"content\"]",
    {
      "display": "flex",
      "flex": "1 1 auto",
      "flex-direction": "column"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-stat\"]",
    {
      "display": "flex",
      "flex-direction": "column",
      "align-items": "center",
      "gap": "var(--artemis-space-1)",
      "min-inline-size": "0",
      "padding-inline": "var(--artemis-space-4)",
      "text-align": "center"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-stat\"] [data-part=\"value\"]",
    {
      "inline-size": "100%",
      "overflow": "hidden",
      "font-size": "clamp(calc(var(--artemis-typography-body-size) * 1.28), 1.8vw, calc(var(--artemis-typography-body-size) * 1.58))",
      "font-variant-numeric": "tabular-nums",
      "font-weight": "var(--artemis-typography-body-weight)",
      "line-height": "1.2",
      "letter-spacing": "-0.02em",
      "text-overflow": "ellipsis",
      "white-space": "nowrap"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-stat\"] [data-part=\"label\"]",
    {
      "color": "var(--artemis-color-text-secondary)",
      "font-size": "var(--artemis-typography-label-size)",
      "line-height": "1.25",
      "overflow-wrap": "anywhere"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"]",
    { "inline-size": "100%", "min-inline-size": "45rem" }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"grid\"]",
    {
      "display": "grid",
      "grid-template-rows": "repeat(var(--data-rows), 0.8125rem)",
      "gap": "var(--artemis-space-1)"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"row\"], [data-artemis-component=\"data-heatmap\"] [data-part=\"column-labels\"]",
    {
      "display": "grid",
      "grid-template-columns": "repeat(var(--data-columns), minmax(0.625rem, 1fr))",
      "gap": "var(--artemis-space-1)"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"]",
    {
      "position": "relative",
      "box-sizing": "border-box",
      "min-inline-size": "0",
      "min-block-size": "0",
      "padding": "0",
      "background": "var(--artemis-color-surface-sunken)",
      "border": "var(--artemis-border-width-default) solid transparent",
      "border-radius": "min(var(--artemis-radius-control), 0.25rem)",
      "cursor": "pointer",
      "transition": "background var(--artemis-motion-duration-fast) var(--artemis-motion-easing-standard), border-color var(--artemis-motion-duration-fast) var(--artemis-motion-easing-standard), transform var(--artemis-motion-duration-fast) var(--artemis-motion-easing-standard)"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"][data-level=\"1\"]",
    {
      "background": "color-mix(in srgb, var(--artemis-color-accent-primary) 28%, var(--artemis-color-surface-sunken))"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"][data-level=\"2\"]",
    {
      "background": "color-mix(in srgb, var(--artemis-color-accent-primary) 48%, var(--artemis-color-surface-sunken))"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"][data-level=\"3\"]",
    {
      "background": "color-mix(in srgb, var(--artemis-color-accent-primary) 70%, var(--artemis-color-surface-base))"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"][data-level=\"4\"]",
    { "background": "var(--artemis-color-accent-primary)" }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"][data-period-active=\"true\"]",
    {
      "border-color": "color-mix(in srgb, var(--artemis-color-accent-primary) 76%, var(--artemis-color-text-primary))"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"]:is(:hover, :focus-visible)",
    {
      "z-index": "1",
      "border-color": "var(--artemis-color-border-strong)",
      "outline": "2px solid Highlight",
      "outline-offset": "1px",
      "transform": "scale(1.08)"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"tooltip\"]",
    {
      "position": "absolute",
      "z-index": "12",
      "inset-block-end": "calc(100% + var(--artemis-space-2))",
      "inset-inline-start": "50%",
      "padding": "var(--artemis-space-2) var(--artemis-space-3)",
      "color": "var(--artemis-color-text-primary)",
      "background": "var(--artemis-color-surface-raised)",
      "border": "var(--artemis-border-width-default) solid var(--artemis-color-border-default)",
      "border-radius": "var(--artemis-radius-card)",
      "box-shadow": "var(--artemis-shadow-overlay)",
      "font-size": "var(--artemis-typography-label-size)",
      "line-height": "1.35",
      "pointer-events": "none",
      "transform": "translateX(-50%)",
      "white-space": "nowrap"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"tooltip\"][data-align=\"end\"]",
    { "inset-inline": "auto 0", "transform": "none" }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"column-labels\"]",
    {
      "grid-auto-flow": "column",
      "grid-template-rows": "1.375rem",
      "margin-block-start": "var(--artemis-space-2)",
      "color": "var(--artemis-color-text-secondary)",
      "font-size": "var(--artemis-typography-metadata-size)"
    }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"] [data-part=\"column-label\"]",
    { "overflow": "visible", "white-space": "nowrap" }
  ],
  [
    "normal|[data-artemis-component=\"data-surface\"][data-state=\"disabled\"], [data-artemis-component=\"data-heatmap\"][data-state=\"disabled\"]",
    { "opacity": "var(--artemis-opacity-disabled)" }
  ],
  [
    "normal|[data-artemis-component=\"data-heatmap\"][data-state=\"disabled\"] [data-part=\"cell\"]",
    { "cursor": "not-allowed" }
  ],
  [
    "compact-width|[data-artemis-component=\"data-stat\"]",
    { "padding": "var(--artemis-space-4) var(--artemis-space-3)" }
  ],
  [
    "reduced-motion|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"]",
    { "transition": "none" }
  ],
  [
    "reduced-motion|[data-artemis-component=\"data-heatmap\"] [data-part=\"cell\"]:is(:hover, :focus-visible)",
    { "transform": "none" }
  ]
]
