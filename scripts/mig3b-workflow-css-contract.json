  [
    "compact-width|[data-artemis-component=\"review-surface\"][data-part=\"workspace\"]",
    { "grid-template-columns": "minmax(0, 1fr) minmax(9rem, 12rem)" }
  ],
  [
    "narrow-width|[data-artemis-component=\"review-surface\"][data-part=\"workspace\"]",
    {
      "grid-template-columns": "minmax(0, 1fr)",
      "grid-template-rows": "minmax(12rem, 1fr) minmax(8rem, auto)"
