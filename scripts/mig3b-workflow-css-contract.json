  [
    "normal|[data-artemis-component=\"sources-surface\"]:is([data-part=\"loading\"], [data-part=\"empty\"], [data-part=\"error\"])",
    { "padding": "var(--artemis-space-6)", "text-align": "center" }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"][data-part=\"error\"]",
