    "normal|[data-artemis-component=\"environment-control\"][data-part=\"trigger\"]:focus-visible, [data-artemis-component=\"goal-editor\"] [data-part=\"input\"]:focus-visible, [data-artemis-component=\"sources-surface\"] button:focus-visible, [data-artemis-component=\"review-surface\"] button:focus-visible",
    { "outline": "2px solid Highlight", "outline-offset": "2px" }
  ],
  [
    "normal|[data-artemis-component=\"environment-panel\"][data-part=\"root\"]",
    {
      "position": "absolute",
      "z-index": "50",
      "inset-block-start": "calc(100% + var(--artemis-space-2))",
