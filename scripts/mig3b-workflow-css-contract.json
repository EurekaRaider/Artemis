      "display": "flex",
      "flex-direction": "column",
      "inline-size": "min(20rem, calc(100vw - var(--artemis-space-6)))",
      "max-block-size": "min(42rem, calc(100vh - var(--artemis-space-6)))",
      "overflow": "auto",
      "padding": "var(--artemis-space-2)",
      "border": "var(--artemis-border-width-default) solid var(--artemis-color-border-default)",
      "border-radius": "var(--artemis-radius-panel)",
      "color": "var(--artemis-color-text-primary)",
      "background": "var(--artemis-color-surface-raised)",
      "box-shadow": "var(--artemis-shadow-overlay)",
      "font-family": "var(--artemis-typography-body-family)"
    }
  ],
  [
    "normal|[data-artemis-component=\"environment-panel\"][data-part=\"section\"]",
    { "padding": "var(--artemis-space-2)" }
  ],
  [
    "normal|[data-artemis-component=\"environment-panel\"][data-part=\"section\"] + [data-artemis-component=\"environment-panel\"][data-part=\"section\"]",
    {
      "border-block-start": "var(--artemis-border-width-default) solid var(--artemis-color-border-subtle)"
    }
  ],
  [
    "normal|[data-artemis-component=\"environment-panel\"][data-part=\"section-header\"]",
    {
      "display": "flex",
      "align-items": "center",
      "justify-content": "space-between",
      "gap": "var(--artemis-space-2)",
      "min-block-size": "var(--artemis-size-control-compact)"
    }
  ],
  [
    "normal|[data-artemis-component=\"environment-panel\"][data-part=\"section-header\"] h2",
    {
      "margin": "0",
      "color": "var(--artemis-color-text-tertiary)",
      "font-size": "var(--artemis-typography-metadata-size)",
      "font-weight": "650",
      "letter-spacing": "0.05em",
      "text-transform": "uppercase"
    }
  ],
  [
    "normal|[data-artemis-component=\"environment-panel\"] .environment-row",
    {
      "box-sizing": "border-box",
      "display": "flex",
      "align-items": "center",
      "justify-content": "space-between",
      "gap": "var(--artemis-space-2)",
      "inline-size": "100%",
      "min-block-size": "var(--artemis-size-control-compact)",
      "padding": "var(--artemis-space-2)",
      "border": "0",
      "border-radius": "var(--artemis-radius-control)",
      "color": "var(--artemis-color-text-primary)",
      "background": "transparent",
      "text-align": "start"
    }
  ],
  [
    "normal|[data-artemis-component=\"environment-panel\"] .environment-row:hover",
    { "background": "var(--artemis-color-interaction-hover)" }
  ],
  [
    "normal|[data-artemis-component=\"goal-editor\"]",
    { "box-sizing": "border-box" }
  ],
  [
    "normal|[data-artemis-component=\"goal-editor\"][data-part=\"root\"]",
    {
      "display": "flex",
      "flex": "1 1 auto",
      "flex-direction": "column",
      "min-inline-size": "0",
      "min-block-size": "0",
      "overflow": "hidden",
      "color": "var(--artemis-color-text-primary)",
      "background": "var(--artemis-color-surface-base)",
      "font-family": "var(--artemis-typography-body-family)"
    }
  ],
  [
    "normal|[data-artemis-component=\"goal-editor\"] [data-part=\"input\"]",
    {
      "box-sizing": "border-box",
      "flex": "1 1 auto",
      "inline-size": "100%",
      "min-block-size": "8rem",
      "padding": "var(--artemis-space-4)",
      "border": "0",
      "color": "var(--artemis-color-text-primary)",
      "background": "transparent",
      "font": "inherit",
      "line-height": "1.6",
      "outline": "0",
      "resize": "none"
    }
  ],
  [
    "normal|[data-artemis-component=\"goal-editor\"] [data-part=\"footer\"]",
    {
      "display": "flex",
      "flex": "0 0 auto",
      "align-items": "center",
      "justify-content": "space-between",
      "gap": "var(--artemis-space-3)",
      "padding": "var(--artemis-space-2) var(--artemis-space-3)",
      "border-block-start": "var(--artemis-border-width-default) solid var(--artemis-color-border-subtle)",
      "color": "var(--artemis-color-text-tertiary)",
      "font-size": "var(--artemis-typography-metadata-size)"
    }
  ],
  [
    "normal|[data-artemis-component=\"goal-editor\"] [data-part=\"actions\"]",
