[
  [
    "normal|[data-artemis-component=\"review-surface\"]",
    {
      "box-sizing": "border-box",
      "min-inline-size": "0",
      "min-block-size": "0",
      "color": "var(--artemis-color-text-primary)",
      "font-family": "var(--artemis-typography-body-family)"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-surface\"][data-part=\"root\"]",
    {
      "display": "flex",
      "flex": "1 1 auto",
      "flex-direction": "column",
      "overflow": "hidden",
      "background": "var(--artemis-color-canvas)"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-surface\"][data-part=\"toolbar\"]",
    {
      "display": "flex",
      "flex": "0 0 auto",
      "align-items": "center",
      "justify-content": "space-between",
      "gap": "var(--artemis-space-3)",
      "min-block-size": "calc(var(--artemis-size-control-compact) + var(--artemis-space-3))",
      "padding": "var(--artemis-space-2) var(--artemis-space-3)",
      "border-block-end": "var(--artemis-border-width-default) solid var(--artemis-color-border-subtle)",
      "color": "var(--artemis-color-text-secondary)"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-surface\"][data-part=\"workspace\"]",
    {
      "display": "grid",
      "flex": "1 1 auto",
      "grid-template-columns": "minmax(0, 1fr) minmax(11rem, 15rem)",
      "min-inline-size": "0",
      "min-block-size": "0",
      "overflow": "hidden"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-surface\"][data-part=\"reader\"], [data-artemis-component=\"review-surface\"][data-part=\"files\"]",
