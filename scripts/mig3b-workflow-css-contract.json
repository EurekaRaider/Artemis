      "display": "flex",
      "align-items": "center",
      "gap": "var(--artemis-space-2)"
    }
  ],
  [
    "normal|[data-artemis-component=\"goal-editor\"]:is([data-state=\"loading\"], [data-state=\"saving\"])",
    { "cursor": "progress" }
  ],
  [
    "normal|[data-artemis-component=\"goal-editor\"][data-state=\"stale\"]",
    { "background": "var(--artemis-color-status-warning-subtle)" }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"]",
    {
      "box-sizing": "border-box",
      "min-inline-size": "0",
      "min-block-size": "0",
      "color": "var(--artemis-color-text-primary)",
      "font-family": "var(--artemis-typography-body-family)"
    }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"][data-part=\"root\"]",
    {
      "display": "flex",
      "flex": "1 1 auto",
      "flex-direction": "column",
      "overflow": "hidden",
      "background": "var(--artemis-color-canvas)"
    }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"][data-part=\"scroll\"]",
    {
      "flex": "1 1 auto",
      "min-inline-size": "0",
      "min-block-size": "0",
      "overflow": "auto",
      "padding": "var(--artemis-space-3)"
    }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"][data-part=\"entry\"]",
    {
      "display": "grid",
      "grid-template-columns": "2rem minmax(0, 1fr)",
      "gap": "var(--artemis-space-3)",
      "min-inline-size": "0",
      "padding": "var(--artemis-space-3)",
      "border-block-end": "var(--artemis-border-width-default) solid var(--artemis-color-border-subtle)"
    }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"] [data-part=\"entry-icon\"]",
    {
      "display": "grid",
      "place-items": "center",
      "inline-size": "2rem",
      "block-size": "2rem",
      "border-radius": "var(--artemis-radius-control)",
      "color": "var(--artemis-color-accent-primary)",
      "background": "var(--artemis-color-accent-subtle)"
    }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"] [data-part=\"entry-body\"]",
    { "min-inline-size": "0" }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"] [data-part=\"entry-body\"] :is(h2, p)",
    {
      "overflow": "hidden",
      "margin": "0",
      "text-overflow": "ellipsis",
      "white-space": "nowrap"
    }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"] [data-part=\"entry-body\"] h2",
    { "font-size": "var(--artemis-typography-label-size)" }
  ],
  [
    "normal|[data-artemis-component=\"sources-surface\"] [data-part=\"entry-body\"] p, [data-artemis-component=\"sources-surface\"]:is([data-part=\"loading\"], [data-part=\"empty\"], [data-part=\"error\"])",
    {
      "color": "var(--artemis-color-text-secondary)",
      "font-size": "var(--artemis-typography-metadata-size)"
