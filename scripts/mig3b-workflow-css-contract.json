      "min-inline-size": "0",
      "min-block-size": "0",
      "overflow": "auto"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-surface\"][data-part=\"files\"]",
    {
      "border-inline-start": "var(--artemis-border-width-default) solid var(--artemis-color-border-subtle)",
      "background": "var(--artemis-color-surface-sunken)"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-surface\"]:is([data-part=\"loading\"], [data-part=\"empty\"], [data-part=\"error\"])",
    {
      "display": "flex",
      "flex-direction": "column",
      "align-items": "center",
      "justify-content": "center",
      "gap": "var(--artemis-space-2)",
      "min-block-size": "10rem",
      "padding": "var(--artemis-space-6)",
      "color": "var(--artemis-color-text-secondary)",
      "text-align": "center"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-surface\"][data-part=\"error\"]",
    { "color": "var(--artemis-color-status-danger)" }
  ],
  [
    "normal|[data-artemis-component=\"review-diff\"]",
    { "box-sizing": "border-box", "min-inline-size": "0" }
  ],
  [
    "normal|[data-artemis-component=\"review-diff\"][data-part=\"root\"]",
    {
      "margin": "var(--artemis-space-3)",
      "overflow": "hidden",
      "border": "var(--artemis-border-width-default) solid var(--artemis-color-border-subtle)",
      "border-radius": "var(--artemis-radius-card)",
      "background": "var(--artemis-color-surface-base)"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-diff\"][data-part=\"header\"], [data-artemis-component=\"review-diff\"] .review-hunk",
    {
      "display": "flex",
      "align-items": "center",
      "gap": "var(--artemis-space-2)",
      "min-inline-size": "0",
      "padding": "var(--artemis-space-2) var(--artemis-space-3)",
      "border-block-end": "var(--artemis-border-width-default) solid var(--artemis-color-border-subtle)",
      "color": "var(--artemis-color-text-secondary)",
      "font-family": "var(--artemis-typography-code-family)",
      "font-size": "var(--artemis-typography-metadata-size)"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-diff\"][data-part=\"line\"]",
    {
      "display": "flex",
      "min-inline-size": "max-content",
      "padding": "2px var(--artemis-space-3)",
      "color": "var(--artemis-color-text-secondary)",
      "font-family": "var(--artemis-typography-code-family)",
      "font-size": "var(--artemis-typography-metadata-size)",
      "line-height": "1.65",
      "white-space": "pre"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-diff\"] [data-part=\"marker\"]",
    {
      "flex": "0 0 1ch",
      "inline-size": "1ch",
      "color": "var(--artemis-color-text-primary)",
      "text-align": "center"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-diff\"][data-part=\"line\"][data-state=\"addition\"]",
    {
      "color": "var(--artemis-color-text-primary)",
      "background": "var(--artemis-color-status-success-subtle)"
    }
  ],
  [
    "normal|[data-artemis-component=\"review-diff\"][data-part=\"line\"][data-state=\"deletion\"]",
    {
      "color": "var(--artemis-color-text-primary)",
      "background": "var(--artemis-color-status-danger-subtle)"
    }
  ],
  [
    "normal|[data-artemis-component=\"environment-control\"]",
    { "box-sizing": "border-box" }
  ],
  [
    "normal|[data-artemis-component=\"environment-control\"][data-part=\"root\"]",
    { "position": "relative" }
  ],
  [
    "normal|[data-artemis-component=\"environment-control\"][data-part=\"trigger\"]",
    {
      "display": "grid",
      "place-items": "center",
      "inline-size": "calc(var(--artemis-size-control-compact) + var(--artemis-space-1))",
      "block-size": "calc(var(--artemis-size-control-compact) + var(--artemis-space-1))",
      "padding": "0",
      "border": "0",
      "border-radius": "var(--artemis-radius-control)",
      "color": "var(--artemis-color-text-secondary)",
      "background": "transparent",
      "cursor": "pointer",
      "transition": "color var(--artemis-motion-duration-fast) var(--artemis-motion-easing-standard), background var(--artemis-motion-duration-fast) var(--artemis-motion-easing-standard)"
    }
  ],
  [
    "normal|[data-artemis-component=\"environment-control\"][data-part=\"trigger\"]:is(:hover, [data-state=\"open\"])",
    {
      "color": "var(--artemis-color-accent-primary)",
      "background": "var(--artemis-color-accent-subtle)"
    }
