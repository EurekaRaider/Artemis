12:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"Plus de possibilités ensemble"}],["$","h2",null,{"children":"Une méthode.\nDeux façons de collaborer."}],["$","p",null,{"children":"Les agents personnalisés apportent leur expertise. Agent Team coordonne le travail sur un ordinateur. Les groupes IM relient les Artemis des différents membres."}]]}],["$","$L17",null,{"label":"Choisir un mode de collaboration","modes":[{"tab":"Avec Agent Team","title":"Vos spécialistes forment une équipe.","body":"Répartissez la recherche et la relecture en tâches indépendantes confiées à des agents personnalisés en parallèle. L’agent principal coordonne les avancées et rassemble les résultats. Suivez chaque rôle dans le panneau de l’équipe.","steps":[{"title":"Répartir le travail","body":"Définissez le résultat attendu pour chaque partie."},{"title":"Solliciter les spécialistes","body":"Utilisez des blocs de tâches @ ou l’appel automatique que vous avez autorisé."},{"title":"Avancer en parallèle","body":"Suivez les missions, les états et les messages dans Agent Team."},{"title":"Réunir les résultats","body":"Ramenez les contributions de chaque rôle dans la tâche en cours."}],"alt":"Agent Team dans Artemis avec tâches parallèles et progression des membres"},{"tab":"Avec les groupes IM","title":"Une demande dans le groupe. Une équipe derrière.","body":"Autorisez l’appel automatique des rôles locaux. Lorsqu’une tâche du groupe arrive dans Artemis, l’agent principal peut les choisir dans le périmètre du projet. Chaque ordinateur accomplit sa part et rend les résultats à la conversation commune.","steps":[{"title":"Demander dans le groupe","body":"Donnez un objectif à un bot autorisé."},{"title":"Attribuer au bon membre","body":"Confiez la partie adaptée à son Artemis."},{"title":"Organiser localement","body":"L’agent principal appelle les spécialistes disponibles et organise son équipe locale."},{"title":"Répondre au groupe","body":"Rassemblez les résultats, répondez au demandeur et poursuivez ensemble."}],"alt":"Collaboration native en groupe IM et tâches des membres dans Artemis"}],"rtl":false}]]}]}]
13:["$","section",null,{"className":"section-shell supporting-features","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"Un espace de travail complet"}],["$","h2",null,{"children":"Les outils pour aller au bout,\naux côtés de l’équipe."}]]}],["$","div",null,{"className":"supporting-grid","children":[["$","article","01",{"children":[["$","p",null,{"className":"eyebrow","children":"Projets et conversations"}],["$","h3",null,{"children":"Gardez le fil de votre travail."}],["$","p",null,{"children":"Enregistrez, recherchez, archivez et bifurquez vos conversations. Les tâches restent près des fichiers ; les conversations temporaires ont leur espace. Les objectifs accompagnent les tâches longues, avec un budget de tokens facultatif."}]]}],["$","article","02",{"children":[["$","p",null,{"className":"eyebrow","children":"Fichiers et documents"}],["$","h3",null,{"children":"Créez un résultat utilisable."}],["$","p",null,{"children":"Modifiez les fichiers, prévisualisez Markdown et créez des contenus Word, Excel, PowerPoint ou PDF avec les plugins fournis. Le contenu de base est conservé, sans garantie pour les macros, animations et mises en page complexes."}]]}],["$","article","03",{"children":[["$","p",null,{"className":"eyebrow","children":"Code et relecture"}],["$","h3",null,{"children":"Comprenez les changements avant de livrer."}],["$","p",null,{"children":"Comparez le dernier tour, l’index ou une branche. Commentez des lignes et indexez des fragments. Travaillez dans votre copie locale ou choisissez explicitement un arbre de travail isolé."}]]}],["$","article","04",{"children":[["$","p",null,{"className":"eyebrow","children":"Terminal et navigateur"}],["$","h3",null,{"children":"Gardez les éléments de vérification à côté."}],["$","p",null,{"children":"Ouvrez un vrai terminal, des pages web et des fichiers près de la conversation. Le navigateur sépare le web des API du bureau et des fichiers locaux."}]]}],["$","article","07",{"children":[["$","p",null,{"className":"eyebrow","children":"Automatisations"}],["$","h3",null,{"children":"Un rythme pour le quotidien."}],["$","p",null,{"children":"Planifiez des tâches ponctuelles, par intervalle, quotidiennes ou hebdomadaires, avec fuseau horaire et historique. Elles tournent lorsque Artemis est ouvert ; le mode Exécution exige une autorisation explicite."}]]}],["$","article","08",{"children":[["$","p",null,{"className":"eyebrow","children":"Plugins et services"}],["$","h3",null,{"children":"Ajoutez ce dont le travail a besoin."}],["$","p",null,{"children":"Gérez plugins, compétences, connecteurs et MCP au même endroit. Découvrez des serveurs, connectez des comptes ou ajoutez un catalogue de confiance. Les catalogues externes ne sont pas consultés par défaut."}]]}],["$","article","09",{"children":[["$","p",null,{"className":"eyebrow","children":"Modèles et utilisation"}],["$","h3",null,{"children":"Trouvez votre équilibre."}],["$","p",null,{"children":"Choisissez un modèle par conversation, ajoutez des fournisseurs compatibles et consultez tokens et cache. Le mode Ultra apporte raisonnement approfondi et travail parallèle aux tâches complexes, avec une consommation accrue."}]]}],["$","article","10",{"children":[["$","p",null,{"className":"eyebrow","children":"Mémoire et langues"}],["$","h3",null,{"children":"Moins de répétitions. Plus de continuité."}],["$","p",null,{"children":"Conservez connaissances et consignes du projet. Importez compétences et réglages de façon sélective sans copier discrètement les identifiants. Utilisez 14 langues, la langue du système et l’affichage de droite à gauche en arabe."}]]}]]}]]}]
