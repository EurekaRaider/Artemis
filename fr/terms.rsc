c:["$","section","5. Tiers et frais",{"children":[["$","h2",null,{"children":"5. Tiers et frais"}],[["$","p","Google, fournisseurs, plugins et autres services ont leurs conditions, disponibilités, quotas et politiques. Vous assumez leurs frais. Connecter Google ne signifie pas qu’il approuve Artemis. Des changements ou expirations d’autorisation peuvent affecter les fonctions.",{"children":"Google, fournisseurs, plugins et autres services ont leurs conditions, disponibilités, quotas et politiques. Vous assumez leurs frais. Connecter Google ne signifie pas qu’il approuve Artemis. Des changements ou expirations d’autorisation peuvent affecter les fonctions."}]]]}]
d:["$","section","6. Contenu et confidentialité",{"children":[["$","h2",null,{"children":"6. Contenu et confidentialité"}],[["$","p","Vous conservez vos droits et autorisez le traitement nécessaire aux fonctions demandées, sans transférer la propriété à Eureka Raider. Consultez la politique sur accès, transferts, rétention, suppression et restrictions Google API.",{"children":"Vous conservez vos droits et autorisez le traitement nécessaire aux fonctions demandées, sans transférer la propriété à Eureka Raider. Consultez la politique sur accès, transferts, rétention, suppression et restrictions Google API."}]]]}]
e:["$","section","7. Disponibilité et responsabilité",{"children":[["$","h2",null,{"children":"7. Disponibilité et responsabilité"}],[["$","p","Dans les limites légales, Artemis est fourni selon disponibilité, sans garantie de continuité, d’adéquation ou d’absence d’erreur. Dans ces mêmes limites, Eureka Raider n’est pas responsable des pertes indirectes ou consécutives, dont celles liées aux tiers ou actions IA non vérifiées. Les responsabilités et droits impératifs des consommateurs restent applicables.",{"children":"Dans les limites légales, Artemis est fourni selon disponibilité, sans garantie de continuité, d’adéquation ou d’absence d’erreur. Dans ces mêmes limites, Eureka Raider n’est pas responsable des pertes indirectes ou consécutives, dont celles liées aux tiers ou actions IA non vérifiées. Les responsabilités et droits impératifs des consommateurs restent applicables."}]]]}]
f:["$","section","8. Fin et modifications",{"children":[["$","h2",null,{"children":"8. Fin et modifications"}],[["$","p","Vous pouvez arrêter, déconnecter et supprimer les données locales à tout moment. Révoquer ne supprime pas automatiquement fichiers ou données déjà transmises. Nous pouvons modifier ou arrêter des fonctions ou limiter nos services pour abus ou obligations légales.",{"children":"Vous pouvez arrêter, déconnecter et supprimer les données locales à tout moment. Révoquer ne supprime pas automatiquement fichiers ou données déjà transmises. Nous pouvons modifier ou arrêter des fonctions ou limiter nos services pour abus ou obligations légales."}],["$","p","Les nouvelles conditions seront datées et publiées ici ; les changements importants seront indiqués dans les conditions ou informations de version. Contactez l’adresse ci-dessous pour toute question.",{"children":"Les nouvelles conditions seront datées et publiées ici ; les changements importants seront indiqués dans les conditions ou informations de version. Contactez l’adresse ci-dessous pour toute question."}]]]}]
