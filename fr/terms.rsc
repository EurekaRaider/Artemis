1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Aller au contenu"}],["$","$Lb",null,{"locale":"fr","copy":{"home":"Présentation","features":"Fonctionnalités","security":"Confidentialité","download":"Télécharger","menu":"Ouvrir la navigation","closeMenu":"Fermer la navigation","primaryLabel":"Navigation principale","mobileLabel":"Navigation mobile","homeLabel":"Accueil Artemis","languageLabel":"Choisir une langue","skipLink":"Aller au contenu"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"En vigueur le 18 septembre 2026 · Exploitant : Eureka Raider"}],["$","h1",null,{"children":"Conditions d’utilisation"}],["$","p",null,{"children":"Vos responsabilités lorsque vous utilisez Artemis et connectez vos comptes et votre travail."}]]}],["$","article",null,{"className":"section-shell legal-document","aria-label":"Conditions d’utilisation","children":[[["$","section","1. Accord et portée",{"children":[["$","h2",null,{"children":"1. Accord et portée"}],[["$","p","Ces conditions régissent le site et le service de bureau Artemis de Eureka Raider. L’utilisation vaut acceptation ; sinon, cessez l’usage. Vous devez avoir la capacité juridique de contracter et être autorisé si vous représentez une organisation. La licence logicielle fournie continue de régir ses droits.",{"children":"Ces conditions régissent le site et le service de bureau Artemis de Eureka Raider. L’utilisation vaut acceptation ; sinon, cessez l’usage. Vous devez avoir la capacité juridique de contracter et être autorisé si vous représentez une organisation. La licence logicielle fournie continue de régir ses droits."}]]]}],["$","section","2. Comptes et autorisations",{"children":[["$","h2",null,{"children":"2. Comptes et autorisations"}],[["$","p","Vous contrôlez comptes, modèles, outils, fichiers et permissions. Connectez uniquement ce que vous êtes autorisé à utiliser, protégez les identifiants et vérifiez les permissions. Vous pouvez déconnecter et révoquer auprès du fournisseur.",{"children":"Vous contrôlez comptes, modèles, outils, fichiers et permissions. Connectez uniquement ce que vous êtes autorisé à utiliser, protégez les identifiants et vérifiez les permissions. Vous pouvez déconnecter et révoquer auprès du fournisseur."}],["$","p","Vous êtes responsable des consignes et de la vérification des actions importantes : messages, fichiers, commandes et calendriers. Sauvegardez les données importantes.",{"children":"Vous êtes responsable des consignes et de la vérification des actions importantes : messages, fichiers, commandes et calendriers. Sauvegardez les données importantes."}]]]}],["$","section","3. Usage acceptable",{"children":[["$","h2",null,{"children":"3. Usage acceptable"}],[["$","p","N’utilisez pas Artemis pour activités illégales, accès non autorisé, fraude, logiciels malveillants, spam, atteintes aux droits ou contournement des contrôles. Respectez les droits et la vie privée des personnes, destinataires et collaborateurs inclus.",{"children":"N’utilisez pas Artemis pour activités illégales, accès non autorisé, fraude, logiciels malveillants, spam, atteintes aux droits ou contournement des contrôles. Respectez les droits et la vie privée des personnes, destinataires et collaborateurs inclus."}]]]}],["$","section","4. IA et automatisation",{"children":[["$","h2",null,{"children":"4. IA et automatisation"}],[["$","p","L’IA peut être inexacte, incomplète ou dépassée. Vérifiez contenus et actions avant de vous y fier. Nous ne garantissons ni le respect de toute instruction ni le résultat d’une automatisation. L’IA ne remplace pas un conseil professionnel qualifié.",{"children":"L’IA peut être inexacte, incomplète ou dépassée. Vérifiez contenus et actions avant de vous y fier. Nous ne garantissons ni le respect de toute instruction ni le résultat d’une automatisation. L’IA ne remplace pas un conseil professionnel qualifié."}]]]}],"$Lc","$Ld","$Le","$Lf"],false,"$L10","$L11"]}]]}],"$L12"]
