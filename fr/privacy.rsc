16:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"className":"section-shell footer-grid","children":[["$","div",null,{"className":"footer-brand","children":[["$","a",null,{"className":"brand","href":"/fr/","children":[["$","$L17",null,{"className":"brand-mark","src":"/images/artemis-icon.png","alt":"","width":"48","height":"48","unoptimized":true}],["$","span",null,{"children":"Artemis"}]]}],["$","p",null,{"children":"Un peu plus de place pour l’essentiel."}]]}],["$","div",null,{"className":"footer-column","children":[["$","h2",null,{"children":"Découvrir Artemis"}],["$","a",null,{"href":"/fr/","children":"Présentation"}],["$","a",null,{"href":"/fr/features/","children":"Fonctionnalités"}],["$","a",null,{"href":"/fr/security/","children":"Confidentialité"}],["$","a",null,{"href":"/fr/download/","children":"Télécharger"}]]}],["$","div",null,{"className":"footer-column","children":[["$","h2",null,{"children":"Confidentialité et assistance"}],["$","a",null,{"href":"/fr/privacy/","children":"Politique de confidentialité"}],["$","a",null,{"href":"/fr/terms/","children":"Conditions d’utilisation"}],["$","a",null,{"href":"mailto:artemis-support@googlegroups.com","children":"Contacter l’assistance"}]]}]]}],["$","div",null,{"className":"section-shell footer-bottom","children":[["$","span",null,{"children":["© ",2026," Eureka Raider"]}],["$","span",null,{"children":"Pour travailler avec attention."}]]}]]}]
