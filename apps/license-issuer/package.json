{
  "name": "artemis-license-issuer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private offline Artemis license signing tool",
  "author": "Artemis",
  "main": "dist/main.cjs",
  "build": {
    "appId": "com.artemis.license-issuer",
    "productName": "Artemis License Issuer",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "zip"
      ]
    }
  }
}
