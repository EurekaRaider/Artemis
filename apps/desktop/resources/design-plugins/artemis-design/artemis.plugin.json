{
  "schemaVersion": 1,
  "id": "com.artemis.design",
  "version": "0.4.0",
  "engines": {
    "artemisPluginApi": "1"
  },
  "projectTypes": [
    {
      "id": "artemis-design",
      "title": {
        "zh-CN": "设计",
        "en": "Design"
      },
      "targets": ["project"],
      "panelIds": ["workspace"]
    }
  ],
  "panels": [
    {
      "id": "workspace",
      "entry": "panel/index.html"
    }
  ],
  "runtime": {
    "entry": "runtime/index.mjs",
    "protocolVersion": 1
  },
  "tools": [
    {
      "name": "get_snapshot",
      "description": "List design-suitable files (pages, images) in the task workspace. Edit targets are plain workspace files — use file editing tools directly; this plugin does not host documents.",
      "effect": "state-read"
    }
  ],
  "capabilities": {
    "projectFiles": "read-only",
    "network": "none",
    "sessionInput": "host-user-action"
  }
}
