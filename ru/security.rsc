f:["$","p",null,{"children":"Локальные MCP-серверы по умолчанию изолированы системными средствами, с отдельными настройками сети и совместимости. Исполняемые расширения требуют явного доверия. Полный локальный доступ относится только к расширениям. Одобренные команды Shell и терминал используют права пользователя рабочего стола. Локальный MCP по умолчанию изолирован; обоснованное и одобренное разовое повышение прав не меняет сохранённые разрешения."}]
10:["$","article","04",{"className":"cell","data-reveal":true,"children":[["$","p",null,{"className":"kicker","children":"Разрешения IM"}],["$","h2",null,{"className":"title","children":"Делитесь в выбранных пределах."}],["$","p",null,{"children":"Разрешайте проекты, папки или файлы для конкретной аудитории. Запись, команды и сеть настраиваются отдельно. Участие в группе само по себе не даёт доступа к компьютеру."}]]}]
