1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to content"}],["$","$Lb",null,{"locale":"en","copy":{"home":"Home","features":"Features","security":"Security","download":"Download","menu":"Open navigation","closeMenu":"Close navigation","primaryLabel":"Primary navigation","mobileLabel":"Mobile navigation","homeLabel":"Artemis home","languageLabel":"Switch to Chinese"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"Effective September 18, 2026 · Operator: Eureka Raider"}],["$","h1",null,{"children":"Privacy Policy"}],["$","p",null,{"children":"Your workspace lives on your device. Connecting an account or using an online model also involves the services you choose. This policy explains those boundaries."}]]}],["$","article",null,{"className":"section-shell legal-document","aria-label":"Privacy Policy","children":[[["$","section","1. Scope and operator",{"children":[["$","h2",null,{"children":"1. Scope and operator"}],[["$","p","Eureka Raider provides Artemis, a desktop AI agent workspace, and this website. This policy covers our handling of information through Artemis, its Google integrations, and support. Third-party services also have their own policies.",{"children":"Eureka Raider provides Artemis, a desktop AI agent workspace, and this website. This policy covers our handling of information through Artemis, its Google integrations, and support. Third-party services also have their own policies."}]]]}],["$","section","2. Information Artemis accesses",{"children":[["$","h2",null,{"children":"2. Information Artemis accesses"}],[["$","p","Artemis processes the prompts, files, project content, tool results, and conversation history you provide or authorize it to access. Your model configuration and connected-account credentials are needed to use the services you select.",{"children":"Artemis processes the prompts, files, project content, tool results, and conversation history you provide or authorize it to access. Your model configuration and connected-account credentials are needed to use the services you select."}],["$","p","If you connect Google, Artemis accesses your account identifier, email address, and profile information to identify the connected account. Depending on the connector and permissions you approve, it can access Gmail message content, headers, recipients, attachments, drafts, and labels; Google Drive file contents and metadata, including documents, spreadsheets, and presentations; and Google Calendar calendars, events, attendees, and availability. The Google consent screen shows the permissions requested.",{"children":"If you connect Google, Artemis accesses your account identifier, email address, and profile information to identify the connected account. Depending on the connector and permissions you approve, it can access Gmail message content, headers, recipients, attachments, drafts, and labels; Google Drive file contents and metadata, including documents, spreadsheets, and presentations; and Google Calendar calendars, events, attendees, and availability. The Google consent screen shows the permissions requested."}]]]}],["$","section","3. Why Google permissions are used",{"children":[["$","h2",null,{"children":"3. Why Google permissions are used"}],[["$","p","Gmail access supports finding and reading messages, drafting or sending messages, and organizing mail when requested. Drive access supports finding, reading, creating, and updating files. Calendar access supports checking schedules and creating, updating, or deleting events. These actions depend on the tools available in your connected service and your task instructions.",{"children":"Gmail access supports finding and reading messages, drafting or sending messages, and organizing mail when requested. Drive access supports finding, reading, creating, and updating files. Calendar access supports checking schedules and creating, updating, or deleting events. These actions depend on the tools available in your connected service and your task instructions."}],"$Lc"]]}],"$Ld","$Le","$Lf","$L10","$L11","$L12"],"$L13","$L14","$L15"]}]]}],"$L16"]
17:I["9fb86276be8f",[],"default",1]
c:["$","p","Google connection is optional. Artemis uses Google data to perform the connected features you request; it does not use that data for advertising, profiling for ads, or credit decisions, and does not sell it.",{"children":"Google connection is optional. Artemis uses Google data to perform the connected features you request; it does not use that data for advertising, profiling for ads, or credit decisions, and does not sell it."}]
d:["$","section","4. Model services and other recipients",{"children":[["$","h2",null,{"children":"4. Model services and other recipients"}],[["$","p","When an agent uses connected Google data, relevant messages, file contents, calendar information, and tool results may become part of the conversation sent to your configured AI model provider to complete your task. Local-first storage does not mean that all processing stays on your device. Choose your provider and its retention settings before using sensitive content.",{"children":"When an agent uses connected Google data, relevant messages, file contents, calendar information, and tool results may become part of the conversation sent to your configured AI model provider to complete your task. Local-first storage does not mean that all processing stays on your device. Choose your provider and its retention settings before using sensitive content."}],["$","p","Connected tools or plugin services receive the data necessary for the actions you authorize. Sending an email, sharing a file, or posting to a connected service also discloses content to the recipients you select. Your device communicates with Google and the services you configure; this website does not receive your Google authorization tokens.",{"children":"Connected tools or plugin services receive the data necessary for the actions you authorize. Sending an email, sharing a file, or posting to a connected service also discloses content to the recipients you select. Your device communicates with Google and the services you configure; this website does not receive your Google authorization tokens."}],["$","p","Google data may be transferred only with your consent to deliver the requested user-facing features, where necessary for security, as required by law, or in connection with an ownership transfer after obtaining your prior express consent.",{"children":"Google data may be transferred only with your consent to deliver the requested user-facing features, where necessary for security, as required by law, or in connection with an ownership transfer after obtaining your prior express consent."}]]]}]
e:["$","section","5. Google API data and Limited Use",{"children":[["$","h2",null,{"children":"5. Google API data and Limited Use"}],[["$","p","Artemis follows the Google API Services User Data Policy and its Limited Use requirements in its use and transfer of information received from Google APIs.",{"children":"Artemis follows the Google API Services User Data Policy and its Limited Use requirements in its use and transfer of information received from Google APIs."}],["$","p","Google user data is not used to develop, improve, or train generalized AI or machine-learning models. Processing relevant content with a model to answer your request is distinct from model training. Only use Google-connected tasks with providers and settings that respect these restrictions.",{"children":"Google user data is not used to develop, improve, or train generalized AI or machine-learning models. Processing relevant content with a model to answer your request is distinct from model training. Only use Google-connected tasks with providers and settings that respect these restrictions."}],["$","p","We do not routinely read Google user data. Human access is limited to your affirmative permission for specific data, necessary security investigations, legal obligations, or aggregated internal operations permitted by Google’s policy.",{"children":"We do not routinely read Google user data. Human access is limited to your affirmative permission for specific data, necessary security investigations, legal obligations, or aggregated internal operations permitted by Google’s policy."}]]]}]
f:["$","section","6. Storage, security, and retention",{"children":[["$","h2",null,{"children":"6. Storage, security, and retention"}],[["$","p","Artemis stores workspace and conversation data on your device. Google connector credentials are encrypted using operating-system credential protection; the connector refuses to save credentials when that protection is unavailable. This does not mean all project files or conversation history are encrypted by Artemis. Protect your device, backups, and account access.",{"children":"Artemis stores workspace and conversation data on your device. Google connector credentials are encrypted using operating-system credential protection; the connector refuses to save credentials when that protection is unavailable. This does not mean all project files or conversation history are encrypted by Artemis. Protect your device, backups, and account access."}],["$","p","Connection credentials remain until you disconnect or remove the relevant local app data. Conversation content and saved task outputs can remain after a connection is removed, until you delete those records or files. Providers receiving task content apply their own retention settings and policies. We do not promise a fixed retention period for data held by those providers.",{"children":"Connection credentials remain until you disconnect or remove the relevant local app data. Conversation content and saved task outputs can remain after a connection is removed, until you delete those records or files. Providers receiving task content apply their own retention settings and policies. We do not promise a fixed retention period for data held by those providers."}]]]}]
10:["$","section","7. Disconnecting, revocation, and deletion",{"children":[["$","h2",null,{"children":"7. Disconnecting, revocation, and deletion"}],[["$","p","Disconnect a Google connector in Artemis to remove its saved local credentials. To revoke Google-side access, remove Artemis from your Google Account’s third-party connections page. Disconnecting locally does not itself revoke Google-side authorization or delete previously saved task content.",{"children":"Disconnect a Google connector in Artemis to remove its saved local credentials. To revoke Google-side access, remove Artemis from your Google Account’s third-party connections page. Disconnecting locally does not itself revoke Google-side authorization or delete previously saved task content."}],["$","p","Delete conversations, exported files, and local application data you no longer need; copies in backups must be removed separately. Disconnecting does not delete your original Gmail messages, Drive files, or Calendar events. Manage those in Google, and contact a model or plugin provider to request deletion of copies it holds.",{"children":"Delete conversations, exported files, and local application data you no longer need; copies in backups must be removed separately. Disconnecting does not delete your original Gmail messages, Drive files, or Calendar events. Manage those in Google, and contact a model or plugin provider to request deletion of copies it holds."}],["$","p","For assistance with access, correction, or deletion, contact the support address below. We can address information provided to us for support, but cannot remotely delete files stored only on your device. Do not send passwords, API keys, authorization tokens, or sensitive message contents to the support mailing list.",{"children":"For assistance with access, correction, or deletion, contact the support address below. We can address information provided to us for support, but cannot remotely delete files stored only on your device. Do not send passwords, API keys, authorization tokens, or sensitive message contents to the support mailing list."}]]]}]
11:["$","section","8. Website and support",{"children":[["$","h2",null,{"children":"8. Website and support"}],[["$","p","This public website is hosted on GitHub Pages. Its hosting provider may process technical request information such as IP addresses and browser details to deliver and secure the website. Download links use GitHub’s release hosting.",{"children":"This public website is hosted on GitHub Pages. Its hosting provider may process technical request information such as IP addresses and browser details to deliver and secure the website. Download links use GitHub’s release hosting."}],["$","p","If you contact support, your email address and the information you submit are processed to respond to your request. The contact address is a Google Groups mailing list, so your message is handled through Google Groups and may be available to group members. Share only the minimum necessary information.",{"children":"If you contact support, your email address and the information you submit are processed to respond to your request. The contact address is a Google Groups mailing list, so your message is handled through Google Groups and may be available to group members. Share only the minimum necessary information."}]]]}]
12:["$","section","9. Policy changes and contact",{"children":[["$","h2",null,{"children":"9. Policy changes and contact"}],[["$","p","We will publish updates on this page with a new effective date. If the use of Google data changes beyond what you previously authorized, we will disclose the change and obtain consent before using your data for the new purpose. Contact Eureka Raider at the address below with privacy or deletion questions.",{"children":"We will publish updates on this page with a new effective date. If the use of Google data changes beyond what you previously authorized, we will disclose the change and obtain consent before using your data for the new purpose. Contact Eureka Raider at the address below with privacy or deletion questions."}]]]}]
