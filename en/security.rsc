c:["$","article","06",{"className":"security-card","children":[["$","div",null,{"children":[["$","span",null,{"className":"item-number","children":"06"}],["$","p",null,{"className":"item-kicker","children":"Project-first memory"}]]}],["$","h2",null,{"children":"Memory is bounded and never outranks the request."}],["$","p",null,{"children":"Experiential memory is validated, scoped to the project first, and lower priority than the current request and system policy. Secrets and transient task state do not belong there."}]]}]
