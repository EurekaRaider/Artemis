1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to content"}],["$","$Lb",null,{"locale":"en","copy":{"home":"Home","features":"Features","security":"Security","download":"Download","github":"View on GitHub","menu":"Open navigation","closeMenu":"Close navigation","primaryLabel":"Primary navigation","mobileLabel":"Mobile navigation","homeLabel":"Artemis home","languageLabel":"Switch to Chinese"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"Security by architecture"}],["$","h1",null,{"children":"Capability is explicit. Boundaries are concrete."}],["$","p",null,{"children":"Artemis does not pretend that local Agent work is risk-free. It makes the execution mode, trust source, and sandbox boundary part of the product architecture."}]]}],["$","section",null,{"className":"section-shell security-boundary","children":[["$","span",null,{"children":"Core boundary"}],["$","h2",null,{"children":"Read-only means execution never receives the call."}],["$","p",null,{"children":"In Plan and Review, writes are denied before an executor or filesystem operation runs. Those modes do not receive Pi bash, MCP tools, or executable extensions."}],["$","div",null,{"className":"boundary-flow","aria-hidden":"true","children":[["$","span",null,{"children":"Plan"}],["$","span",null,{"children":"Review"}],["$","strong",null,{"children":"Read-only boundary"}],["$","span",null,{"className":"execute","children":"Execute"}]]}]]}],["$","section",null,{"className":"section-shell security-grid","children":[["$","article","01",{"className":"security-card","children":[["$","div",null,{"children":[["$","span",null,{"className":"item-number","children":"01"}],["$","p",null,{"className":"item-kicker","children":"Modes"}]]}],["$","h2",null,{"children":"Plan and Review stay read-only."}],["$","p",null,{"children":"The protection is enforced before the side effect path, rather than relying on the Agent to remember a conversational instruction."}]]}],["$","article","02",{"className":"security-card","children":[["$","div",null,{"children":[["$","span",null,{"className":"item-number","children":"02"}],["$","p",null,{"className":"item-kicker","children":"Policy and approval"}]]}],["$","h2",null,{"children":"Execute makes power visible and policy-aware."}],["$","p",null,{"children":"Pi bash is available only in Execute and runs with the current desktop user’s filesystem and network permissions. Tool actions follow the configured policy and approval path; Artemis does not claim that every execution requires manual approval."}]]}],["$","article","03",{"className":"security-card","children":[["$","div",null,{"children":[["$","span",null,{"className":"item-number","children":"03"}],["$","p",null,{"className":"item-kicker","children":"AppContainer and Seatbelt"}]]}],["$","h2",null,{"children":"Local MCP servers start inside an OS sandbox."}],["$","p",null,{"children":"Enabled local stdio servers use AppContainer on Windows or Seatbelt on macOS by default. File access is limited to the task workspace and private runtime directory; network and environment access are configured per server."}]]}],["$","article","04",{"className":"security-card","children":[["$","div",null,{"children":[["$","span",null,{"className":"item-number","children":"04"}],["$","p",null,{"className":"item-kicker","children":"Executable extensions"}]]}],["$","h2",null,{"children":"Trust is tied to the project and content hash."}],["$","p",null,{"children":"Extensions remain disabled until explicitly trusted and use the platform-native sandbox by default. Full local access is an extension-only compatibility choice; it does not alter Pi bash, Terminal, or MCP permissions."}]]}],["$","article","05",{"className":"security-card","children":[["$","div",null,{"children":[["$","span",null,{"className":"item-number","children":"05"}],["$","p",null,{"className":"item-kicker","children":"Credentials"}]]}],["$","h2",null,{"children":"Secrets use the operating system’s protected storage."}],["$","p",null,{"children":"Artemis stores supported credentials through Electron safeStorage. Configuration import is category-selective and must not silently copy credentials."}]]}],"$Lc","$Ld"]}],"$Le"]}],"$Lf"]
