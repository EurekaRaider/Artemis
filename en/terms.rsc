1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to content"}],["$","$Lb",null,{"locale":"en","copy":{"home":"Overview","features":"Features","security":"Privacy & control","download":"Download","menu":"Open navigation","closeMenu":"Close navigation","primaryLabel":"Primary navigation","mobileLabel":"Mobile navigation","homeLabel":"Artemis home","languageLabel":"Choose a language","skipLink":"Skip to content"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"Effective September 19, 2026 · Operator: Eureka Raider"}],["$","h1",null,{"children":"Terms of Service"}],["$","p",null,{"children":"These terms describe the responsibilities that come with using Artemis and connecting it to your accounts and work."}]]}],["$","article",null,{"className":"section-shell legal-document","aria-label":"Terms of Service","children":[[["$","section","1. Agreement and scope",{"children":[["$","h2",null,{"children":"1. Agreement and scope"}],[["$","p","These terms govern your use of the Artemis website and desktop service provided by Eureka Raider. By using them, you agree to these terms. If you do not agree, stop using the service. You must be able to enter into this agreement under the laws that apply to you; if acting for an organization, you must have its authority. Any software license supplied with a release continues to govern the rights granted under that license.",{"children":"These terms govern your use of the Artemis website and desktop service provided by Eureka Raider. By using them, you agree to these terms. If you do not agree, stop using the service. You must be able to enter into this agreement under the laws that apply to you; if acting for an organization, you must have its authority. Any software license supplied with a release continues to govern the rights granted under that license."}]]]}],["$","section","2. Your accounts and authorization",{"children":[["$","h2",null,{"children":"2. Your accounts and authorization"}],[["$","p","You control the accounts, model services, tools, files, and permissions you connect. Only connect data and accounts you have authority to use, keep your credentials secure, and review requested permissions. You may disconnect a service and revoke access through that provider.",{"children":"You control the accounts, model services, tools, files, and permissions you connect. Only connect data and accounts you have authority to use, keep your credentials secure, and review requested permissions. You may disconnect a service and revoke access through that provider."}],["$","p","You are responsible for instructions issued through your workspace and for reviewing consequential actions, including sending messages, changing files, running commands, and modifying calendars. Maintain backups of important data.",{"children":"You are responsible for instructions issued through your workspace and for reviewing consequential actions, including sending messages, changing files, running commands, and modifying calendars. Maintain backups of important data."}]]]}],["$","section","3. Acceptable use",{"children":[["$","h2",null,{"children":"3. Acceptable use"}],[["$","p","Do not use Artemis for unlawful activity, unauthorized access, fraud, malware, spam, infringement of others’ rights, or attempts to evade access controls. Respect the privacy and rights of people whose information you process, including email recipients and document collaborators.",{"children":"Do not use Artemis for unlawful activity, unauthorized access, fraud, malware, spam, infringement of others’ rights, or attempts to evade access controls. Respect the privacy and rights of people whose information you process, including email recipients and document collaborators."}]]]}],"$Lc","$Ld","$Le","$Lf","$L10"],false,"$L11","$L12"]}]]}],"$L13"]
