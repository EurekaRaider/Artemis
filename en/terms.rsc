c:["$","section","4. AI outputs and automation",{"children":[["$","h2",null,{"children":"4. AI outputs and automation"}],[["$","p","AI output may be inaccurate, incomplete, or outdated. Review generated content and tool actions before relying on them. Artemis does not guarantee that a model will follow every instruction or that an automated action will have the intended result. AI output is not a substitute for qualified professional advice.",{"children":"AI output may be inaccurate, incomplete, or outdated. Review generated content and tool actions before relying on them. Artemis does not guarantee that a model will follow every instruction or that an automated action will have the intended result. AI output is not a substitute for qualified professional advice."}]]]}]
d:["$","section","5. Third-party services and costs",{"children":[["$","h2",null,{"children":"5. Third-party services and costs"}],[["$","p","Google, model providers, plugins, and other connected services operate under their own terms, availability, quotas, and privacy policies. You are responsible for applicable provider charges. Connecting a Google account does not imply that Google endorses Artemis. Features may change or stop working if a provider changes its service or your authorization expires.",{"children":"Google, model providers, plugins, and other connected services operate under their own terms, availability, quotas, and privacy policies. You are responsible for applicable provider charges. Connecting a Google account does not imply that Google endorses Artemis. Features may change or stop working if a provider changes its service or your authorization expires."}]]]}]
e:["$","section","6. Your content and privacy",{"children":[["$","h2",null,{"children":"6. Your content and privacy"}],[["$","p","You retain your rights in the content you provide. You authorize processing of that content as needed to perform the features and tasks you request. These terms do not grant ownership of your content to Eureka Raider. Read the Privacy Policy for data access, transfers, retention, and deletion, including Google API data restrictions.",{"children":"You retain your rights in the content you provide. You authorize processing of that content as needed to perform the features and tasks you request. These terms do not grant ownership of your content to Eureka Raider. Read the Privacy Policy for data access, transfers, retention, and deletion, including Google API data restrictions."}]]]}]
f:["$","section","7. Availability and responsibility",{"children":[["$","h2",null,{"children":"7. Availability and responsibility"}],[["$","p","To the extent allowed by applicable law, Artemis is provided as available, without a guarantee of uninterrupted operation, fitness for a particular purpose, or error-free results. To that same extent, Eureka Raider is not responsible for indirect or consequential loss resulting from use of the service, including losses caused by third-party services or unreviewed AI actions. Nothing in these terms excludes liability or statutory consumer rights that cannot lawfully be excluded.",{"children":"To the extent allowed by applicable law, Artemis is provided as available, without a guarantee of uninterrupted operation, fitness for a particular purpose, or error-free results. To that same extent, Eureka Raider is not responsible for indirect or consequential loss resulting from use of the service, including losses caused by third-party services or unreviewed AI actions. Nothing in these terms excludes liability or statutory consumer rights that cannot lawfully be excluded."}]]]}]
10:["$","section","8. Ending use and changes",{"children":[["$","h2",null,{"children":"8. Ending use and changes"}],[["$","p","You may stop using Artemis at any time, disconnect accounts, and remove local application data. Revoking access does not automatically delete files or data already sent to third parties. We may change or discontinue features, or restrict services we operate in response to misuse or legal requirements.",{"children":"You may stop using Artemis at any time, disconnect accounts, and remove local application data. Revoking access does not automatically delete files or data already sent to third parties. We may change or discontinue features, or restrict services we operate in response to misuse or legal requirements."}],["$","p","Updated terms will be published here with a new effective date. Material changes will be identified in the updated terms or associated release information. Contact the address below with questions about these terms or the service.",{"children":"Updated terms will be published here with a new effective date. Material changes will be identified in the updated terms or associated release information. Contact the address below with questions about these terms or the service."}]]]}]
