10:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"能力，放在一起更有用"}],["$","h2",null,{"children":"一套方法，\n两种协作方式。"}],["$","p",null,{"children":"自定义智能体提供专长，Agent Team 组织本机分工，IM 群把不同成员的 Artemis 连接起来。"}]]}],["$","$L14",null,{"label":"选择协作方式","modes":[{"tab":"与 Agent Team 配合","title":"让你的专业角色，组成一支团队。","body":"把研究和审阅分成独立任务，交给不同的自定义智能体并行处理。主智能体协调进展、整理结果，你可以在团队面板查看每个角色的工作。","steps":[{"title":"拆分任务","body":"明确每个部分要完成什么。"},{"title":"调用专业角色","body":"通过 @ 任务块或已允许的自动调用，选用自定义智能体。"},{"title":"并行推进","body":"在 Agent Team 中查看分工、状态和消息。"},{"title":"汇总成果","body":"把各个角色的结果带回当前任务。"}],"alt":"Artemis Agent Team 面板中的并行任务与成员进展"},{"tab":"与 IM 群协作配合","title":"群里交代一件事，背后是一支队伍。","body":"为本机角色开启自动调用后，群任务到达对应的 Artemis，主智能体就能按项目范围选用这些角色。每位成员的电脑负责自己的部分，结果回到共同的对话。","steps":[{"title":"群里发起","body":"向已授权的机器人交代目标。"},{"title":"定向分派","body":"把适合的工作交给对应成员的 Artemis。"},{"title":"本机分工","body":"主智能体调用可用的专业角色，组织本机团队。"},{"title":"回到群里","body":"汇总结果并回复原请求者，继续协作。"}],"alt":"Artemis 原生 IM 群协作与成员任务"}],"locale":"zh-CN","rtl":false}]]}]}]
