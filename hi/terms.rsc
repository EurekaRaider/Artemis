c:["$","section","6. सामग्री और गोपनीयता",{"children":[["$","h2",null,{"children":"6. सामग्री और गोपनीयता"}],[["$","p","आप सामग्री के अधिकार रखते हैं और अनुरोधित काम के लिए आवश्यक प्रसंस्करण की अनुमति देते हैं; स्वामित्व Eureka Raider को नहीं मिलता। पहुँच, हस्तांतरण, संग्रह, हटाने और Google API प्रतिबंध के लिए नीति पढ़ें।",{"children":"आप सामग्री के अधिकार रखते हैं और अनुरोधित काम के लिए आवश्यक प्रसंस्करण की अनुमति देते हैं; स्वामित्व Eureka Raider को नहीं मिलता। पहुँच, हस्तांतरण, संग्रह, हटाने और Google API प्रतिबंध के लिए नीति पढ़ें।"}]]]}]
d:["$","section","7. उपलब्धता और दायित्व",{"children":[["$","h2",null,{"children":"7. उपलब्धता और दायित्व"}],[["$","p","कानून की अनुमति तक Artemis उपलब्ध स्थिति में है; निरंतरता, किसी उद्देश्य की उपयुक्तता या त्रुटिहीनता की गारंटी नहीं। उसी सीमा तक तीसरे पक्ष या बिना जाँचे AI कार्य सहित अप्रत्यक्ष या परिणामी हानि के लिए Eureka Raider जिम्मेदार नहीं। जो दायित्व और उपभोक्ता अधिकार हटाए नहीं जा सकते, वे सुरक्षित हैं।",{"children":"कानून की अनुमति तक Artemis उपलब्ध स्थिति में है; निरंतरता, किसी उद्देश्य की उपयुक्तता या त्रुटिहीनता की गारंटी नहीं। उसी सीमा तक तीसरे पक्ष या बिना जाँचे AI कार्य सहित अप्रत्यक्ष या परिणामी हानि के लिए Eureka Raider जिम्मेदार नहीं। जो दायित्व और उपभोक्ता अधिकार हटाए नहीं जा सकते, वे सुरक्षित हैं।"}]]]}]
e:["$","section","8. समाप्ति और बदलाव",{"children":[["$","h2",null,{"children":"8. समाप्ति और बदलाव"}],[["$","p","कभी भी उपयोग रोकें, खाते हटाएँ और स्थानीय डेटा मिटाएँ। अनुमति वापस लेना अपने आप फ़ाइलें या भेजा डेटा नहीं हटाता। हम सुविधाएँ बदल या बंद कर सकते हैं, और दुरुपयोग या कानून के कारण अपनी सेवाएँ सीमित कर सकते हैं।",{"children":"कभी भी उपयोग रोकें, खाते हटाएँ और स्थानीय डेटा मिटाएँ। अनुमति वापस लेना अपने आप फ़ाइलें या भेजा डेटा नहीं हटाता। हम सुविधाएँ बदल या बंद कर सकते हैं, और दुरुपयोग या कानून के कारण अपनी सेवाएँ सीमित कर सकते हैं।"}],["$","p","नई शर्तें तारीख के साथ यहाँ प्रकाशित होंगी; बड़े बदलाव शर्तों या रिलीज़ सूचना में बताए जाएँगे। सवाल नीचे दिए संपर्क पर भेजें।",{"children":"नई शर्तें तारीख के साथ यहाँ प्रकाशित होंगी; बड़े बदलाव शर्तों या रिलीज़ सूचना में बताए जाएँगे। सवाल नीचे दिए संपर्क पर भेजें।"}]]]}]
