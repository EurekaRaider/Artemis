1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"मुख्य सामग्री पर जाएँ"}],["$","$Lb",null,{"locale":"hi","copy":{"home":"परिचय","features":"सुविधाएँ","security":"गोपनीयता और नियंत्रण","download":"डाउनलोड","menu":"नेविगेशन खोलें","closeMenu":"नेविगेशन बंद करें","primaryLabel":"मुख्य नेविगेशन","mobileLabel":"मोबाइल नेविगेशन","homeLabel":"Artemis का मुखपृष्ठ","languageLabel":"भाषा चुनें","skipLink":"मुख्य सामग्री पर जाएँ"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"प्रभावी: 19 सितंबर 2026 · संचालक: Eureka Raider"}],["$","h1",null,{"children":"सेवा की शर्तें"}],["$","p",null,{"children":"Artemis इस्तेमाल करने और खाते व काम जोड़ने की जिम्मेदारियाँ।"}]]}],["$","article",null,{"className":"section-shell legal-document","aria-label":"सेवा की शर्तें","children":[[["$","section","1. समझौता और दायरा",{"children":[["$","h2",null,{"children":"1. समझौता और दायरा"}],[["$","p","ये Eureka Raider की Artemis वेबसाइट और डेस्कटॉप सेवा पर लागू हैं। उपयोग का अर्थ सहमति है; असहमति हो तो रुकें। कानूनी अनुबंध क्षमता और संस्था का प्रतिनिधित्व करने पर अधिकार आवश्यक है। साथ मिला सॉफ़्टवेयर लाइसेंस अपने दिए अधिकारों पर लागू रहता है।",{"children":"ये Eureka Raider की Artemis वेबसाइट और डेस्कटॉप सेवा पर लागू हैं। उपयोग का अर्थ सहमति है; असहमति हो तो रुकें। कानूनी अनुबंध क्षमता और संस्था का प्रतिनिधित्व करने पर अधिकार आवश्यक है। साथ मिला सॉफ़्टवेयर लाइसेंस अपने दिए अधिकारों पर लागू रहता है।"}]]]}],["$","section","2. खाते और अनुमति",{"children":[["$","h2",null,{"children":"2. खाते और अनुमति"}],[["$","p","खाते, मॉडल, टूल, फ़ाइलें और अनुमतियाँ आपके नियंत्रण में हैं। केवल अधिकृत चीज़ें जोड़ें, क्रेडेंशियल सुरक्षित रखें और अनुमतियाँ देखें। सेवा डिस्कनेक्ट कर प्रदाता से अनुमति वापस ले सकते हैं।",{"children":"खाते, मॉडल, टूल, फ़ाइलें और अनुमतियाँ आपके नियंत्रण में हैं। केवल अधिकृत चीज़ें जोड़ें, क्रेडेंशियल सुरक्षित रखें और अनुमतियाँ देखें। सेवा डिस्कनेक्ट कर प्रदाता से अनुमति वापस ले सकते हैं।"}],["$","p","निर्देशों और संदेश, फ़ाइल बदलाव, कमांड व कैलेंडर जैसे प्रभावशाली कामों की समीक्षा की जिम्मेदारी आपकी है। महत्वपूर्ण डेटा का बैकअप लें।",{"children":"निर्देशों और संदेश, फ़ाइल बदलाव, कमांड व कैलेंडर जैसे प्रभावशाली कामों की समीक्षा की जिम्मेदारी आपकी है। महत्वपूर्ण डेटा का बैकअप लें।"}]]]}],["$","section","3. स्वीकार्य उपयोग",{"children":[["$","h2",null,{"children":"3. स्वीकार्य उपयोग"}],[["$","p","अवैध काम, अनधिकृत पहुँच, धोखाधड़ी, मालवेयर, स्पैम, अधिकार उल्लंघन या पहुँच नियंत्रण से बचने के लिए इस्तेमाल न करें। प्राप्तकर्ता और सहयोगियों सहित सभी की गोपनीयता व अधिकारों का सम्मान करें।",{"children":"अवैध काम, अनधिकृत पहुँच, धोखाधड़ी, मालवेयर, स्पैम, अधिकार उल्लंघन या पहुँच नियंत्रण से बचने के लिए इस्तेमाल न करें। प्राप्तकर्ता और सहयोगियों सहित सभी की गोपनीयता व अधिकारों का सम्मान करें।"}]]]}],["$","section","4. AI और स्वचालन",{"children":[["$","h2",null,{"children":"4. AI और स्वचालन"}],[["$","p","AI में गलती, कमी या पुरानी जानकारी हो सकती है। भरोसा करने से पहले सामग्री और कार्य देखें। हर निर्देश के पालन या स्वचालन के परिणाम की गारंटी नहीं है। AI योग्य पेशेवर सलाह का विकल्प नहीं है।",{"children":"AI में गलती, कमी या पुरानी जानकारी हो सकती है। भरोसा करने से पहले सामग्री और कार्य देखें। हर निर्देश के पालन या स्वचालन के परिणाम की गारंटी नहीं है। AI योग्य पेशेवर सलाह का विकल्प नहीं है।"}]]]}],["$","section","5. तीसरे पक्ष और लागत",{"children":[["$","h2",null,{"children":"5. तीसरे पक्ष और लागत"}],[["$","p","Google, मॉडल, प्लगइन और सेवाओं की अपनी शर्तें, उपलब्धता, सीमा और नीतियाँ हैं। शुल्क आपकी जिम्मेदारी है। Google जोड़ना उसका Artemis समर्थन नहीं दर्शाता। सेवा बदलाव या अनुमति खत्म होने से सुविधाएँ प्रभावित हो सकती हैं।",{"children":"Google, मॉडल, प्लगइन और सेवाओं की अपनी शर्तें, उपलब्धता, सीमा और नीतियाँ हैं। शुल्क आपकी जिम्मेदारी है। Google जोड़ना उसका Artemis समर्थन नहीं दर्शाता। सेवा बदलाव या अनुमति खत्म होने से सुविधाएँ प्रभावित हो सकती हैं।"}]]]}],"$Lc","$Ld","$Le"],false,"$Lf","$L10"]}]]}],"$L11"]
