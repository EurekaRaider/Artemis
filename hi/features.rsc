f:["$","article","आपकी प्रक्रिया, सही समय पर।",{"children":[["$","h3",null,{"children":"आपकी प्रक्रिया, सही समय पर।"}],["$","p",null,{"children":"सेटिंग्स में कमांड Hooks की समीक्षा करके स्पष्ट भरोसा दें। वे Work और Codemode में चलते हैं; Plan उन्हें छोड़ देता है। प्लगइन, Skills और MCP संसाधन केंद्र में मिलते हैं।"}]]}]
10:["$","article","इंटरैक्टिव प्लगइन",{"children":[["$","h3",null,{"children":"इंटरैक्टिव प्लगइन"}],["$","p",null,{"children":"अलग वातावरण में चलने वाले पैनल और टूल जोड़ें। Design स्थापित और उपलब्ध होने पर दस्तावेज़ बनाएँ, संस्करण देखें, बदलाव पूर्ववत करें और बहाल करें। प्रोजेक्ट फ़ाइलें स्पष्ट रूप से आयात करनी होती हैं।"}]]}]
11:["$","section",null,{"id":"office","className":"section-shell feature-story","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"Office · DOCX / XLSX / PPTX / CSV"}],["$","h2",null,{"children":"आपके दस्तावेज़, बातचीत के ठीक पास।"}],["$","p",null,{"children":"Office कार्यक्षेत्र में Word, Excel और PowerPoint फ़ाइलों का पूर्वावलोकन करें, संपादित करें और टिप्पणियाँ जोड़ें। मैन्युअल संपादन स्थानीय रूप से होता है, जिसमें अपने-आप सहेजना, पूर्ववत करना और फिर से करना शामिल हैं।"}],["$","p",null,{"className":"story-note","children":"Office पूर्वावलोकन के लिए वैकल्पिक Office घटक स्थापित और सक्रिय होना चाहिए। बुनियादी दस्तावेज़ प्लगइन अलग से उपलब्ध हैं।"}],["$","p",null,{"children":"Documents, Presentations या Spreadsheets में Office अपग्रेड चुनकर साझा वैकल्पिक घटक ऑनलाइन इंस्टॉल करें या .artemis-office फ़ाइल आयात करें। macOS Apple Silicon और Windows x64 पर उपलब्ध; संपादन और सहेजने के लिए Work / Codemode मोड आवश्यक है।"}],["$","p",null,{"className":"story-note","children":"Office फ़ाइलें कार्य प्रति में सहेजी जाती हैं और मूल सुरक्षित रहता है। बाहरी बदलावों से टकराव होने पर सहेजना रोका जाता है। समर्थित टेक्स्ट और सेल संपादित किए जा सकते हैं; यह पूर्ण Office लेआउट संपादक नहीं है और जटिल फ़ॉर्मैटिंग में अंतर हो सकता है।"}]]}],["$","div",null,{"className":"connection-journey","children":["$","ol",null,{"children":[["$","li","Word और PowerPoint",{"children":[["$","span",null,{"className":"journey-number","aria-hidden":"true","children":1}],["$","div",null,{"children":[["$","h3",null,{"children":"Word और PowerPoint"}],["$","p",null,{"children":"स्पष्ट रूप से पहचाने जा सकने वाले DOCX अनुच्छेद और PPTX ऑब्जेक्ट टेक्स्ट वहीं संपादित करें। ज़ूम और स्लाइड थंबनेल से पृष्ठों की जाँच करें।"}]]}]]}],["$","li","Excel और CSV",{"children":[["$","span",null,{"className":"journey-number","aria-hidden":"true","children":2}],["$","div",null,{"children":[["$","h3",null,{"children":"Excel और CSV"}],["$","p",null,{"children":"हर शीट में 