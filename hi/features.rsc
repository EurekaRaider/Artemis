10:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"मिलकर बढ़ती क्षमताएँ"}],["$","h2",null,{"children":"एक तरीका।\nसहयोग के दो रूप।"}],["$","p",null,{"children":"कस्टम एजेंट विशेषज्ञता लाते हैं। Agent Team एक कंप्यूटर पर काम बाँटता है। IM समूह अलग-अलग सदस्यों के Artemis को जोड़ते हैं।"}]]}],["$","$L15",null,{"label":"सहयोग का तरीका चुनें","modes":[{"tab":"Agent Team के साथ","title":"अपनी विशेषज्ञ भूमिकाओं से टीम बनाएँ।","body":"शोध और समीक्षा को स्वतंत्र कामों में बाँटें, जिन्हें कस्टम एजेंट समानांतर पूरा करें। मुख्य एजेंट प्रगति का समन्वय करके परिणाम जोड़ता है। टीम पैनल में हर भूमिका का काम देखें।","steps":[{"title":"काम बाँटें","body":"हर हिस्से का अपेक्षित परिणाम तय करें।"},{"title":"विशेषज्ञ बुलाएँ","body":"@ टास्क ब्लॉक या आपकी अनुमति वाला स्वचालित आह्वान इस्तेमाल करें।"},{"title":"समानांतर आगे बढ़ें","body":"Agent Team में काम, स्थिति और संदेश देखें।"},{"title":"परिणाम जोड़ें","body":"हर भूमिका का योगदान मौजूदा काम में वापस लाएँ।"}],"alt":"Artemis Agent Team में समानांतर काम और सदस्यों की प्रगति"},{"tab":"IM समूहों के साथ","title":"समूह में एक अनुरोध। पीछे पूरी टीम।","body":"स्थानीय भूमिकाओं का स्वचालित आह्वान चालू करें। समूह का काम Artemis तक पहुँचने पर मुख्य एजेंट प्रोजेक्ट की सीमा में उन भूमिकाओं को चुन सकता है। हर कंप्यूटर अपना हिस्सा करता है और परिणाम साझा बातचीत में लौटाता है।","steps":[{"title":"समूह में अनुरोध","body":"अधिकृत बॉट को लक्ष्य बताएँ।"},{"title":"सदस्य को सौंपें","body":"सही हिस्सा उस सदस्य के Artemis को भेजें।"},{"title":"कंप्यूटर पर समन्वय","body":"मुख्य एजेंट उपलब्ध विशेषज्ञ बुलाकर अपनी स्थानीय टीम बनाता है।"},{"title":"समूह में जवाब","body":"परिणाम जोड़ें, अनुरोधकर्ता को जवाब दें और सहयोग जारी रखें।"}],"alt":"Artemis में मूल IM समूह सहयोग और सदस्यों के काम"}],"locale":"hi","rtl":false}]]}]}]
