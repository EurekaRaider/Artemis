,"children":[["$","article","परिणाम बातचीत के भीतर।",{"children":[["$","h3",null,{"children":"परिणाम बातचीत के भीतर।"}],["$","p",null,{"children":"चित्र, एनिमेटेड SVG, ऑडियो, वीडियो, Mermaid और LaTeX देखें। इंटरैक्टिव स्थानीय HTML अलग वातावरण में चलता है; Office और PDF कार्ड साइड व्यूअर खोलते हैं।"}]]}],["$","article","आपके अंदाज़ का कार्यक्षेत्र।",{"children":[["$","h3",null,{"children":"आपके अंदाज़ का कार्यक्षेत्र।"}],["$","p",null,{"children":"स्किन प्लगइन की झलक देखें और लागू करें या डिफ़ॉल्ट रूप वापस लाएँ। समर्थित स्किन में हल्के और गहरे वॉलपेपर, मूक वीडियो, फ़ॉन्ट, आइकन और कम गति का विकल्प मिलता है।"}]]}],"$Lf","$L10"]}]]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}],"$L19"]]
