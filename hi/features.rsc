1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"मुख्य सामग्री पर जाएँ"}],["$","$Lb",null,{"locale":"hi","copy":{"home":"परिचय","features":"सुविधाएँ","security":"गोपनीयता और नियंत्रण","download":"डाउनलोड","menu":"नेविगेशन खोलें","closeMenu":"नेविगेशन बंद करें","primaryLabel":"मुख्य नेविगेशन","mobileLabel":"मोबाइल नेविगेशन","homeLabel":"Artemis का मुखपृष्ठ","languageLabel":"भाषा चुनें","skipLink":"मुख्य सामग्री पर जाएँ"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"करीब से जानें"}],["$","h1",null,{"children":"पहले विचार से पूरे हुए काम तक।"}],["$","p",null,{"children":"जारी रहने वाली बातचीत और उसे उपयोगी परिणाम बनाने वाले टूल।"}]]}],["$","section",null,{"className":"section-shell feature-list","children":[["$","article","01",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"01"}],["$","p",null,{"children":"प्रोजेक्ट और बातचीत"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"काम की कड़ी बनाए रखें।"}],["$","p",null,{"children":"बातचीत सहेजें, खोजें, संग्रहित करें और शाखा बनाएँ। प्रोजेक्ट कार्य फ़ाइलों के साथ रहते हैं; अस्थायी चैट की अलग जगह होती है। लक्ष्य लंबे काम में दिशा देते हैं, वैकल्पिक टोकन बजट के साथ।"}]]}]]}],["$","article","02",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"02"}],["$","p",null,{"children":"फ़ाइलें और दस्तावेज़"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"इस्तेमाल योग्य परिणाम बनाएँ।"}],["$","p",null,{"children":"फ़ाइलें पढ़ें और बदलें, Markdown देखें तथा शामिल प्लगइन से Word, Excel, PowerPoint या PDF बनाएँ। बुनियादी सामग्री सुरक्षित रहती है; मैक्रो, एनीमेशन और जटिल लेआउट की पूरी रक्षा की गारंटी नहीं है।"}]]}]]}],["$","article","03",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"03"}],["$","p",null,{"children":"कोड और समीक्षा"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"सौंपने से पहले बदलाव समझें।"}],["$","p",null,{"children":"पिछली बारी, स्टेज किए बदलाव या शाखा की तुलना करें। पंक्ति पर टिप्पणी और हिस्सों को स्टेज करें। स्थानीय प्रति या स्पष्ट रूप से चुने अलग वर्कट्री में काम करें।"}]]}]]}],["$","article","04",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"04"}],["$","p",null,{"children":"टर्मिनल और ब्राउज़र"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"जाँच के साधन पास रखें।"}],["$","p",null,{"children":"बातचीत के पास वास्तविक टर्मिनल, वेब पेज और फ़ाइलें खोलें। ब्राउज़र वेब सामग्री को डेस्कटॉप API और स्थानीय फ़ाइलों से अलग रखता है।"}]]}]]}],["$","article","05",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"05"}],["$","p",null,{"children":"एजेंट टीम"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"हर हिस्से पर अलग ध्यान।"}],["$","p",null,{"children":"स्वतंत्र कामों की जाँच एजेंट समानांतर कर सकते हैं। अपने निर्देश, मॉडल और अनुमत टूल वाले विशेषज्ञ बनाएँ; @ से बुलाएँ और प्रगति देखें।"}]]}]]}],["$","article","06",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"06"}],["$","p",null,{"children":"संदेश और सहयोग"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"बातचीत की जगह से काम जारी रखें।"}],["$","p",null,{"children":"WeCom, Feishu / Lark या Slack की निजी चैट से काम दें। Slack और Feishu / Lark समूहों में अलग जुड़े बॉट अधिकृत काम पर सहयोग कर अनुरोधकर्ता को जवाब देते हैं। कंप्यूटर और Artemis चलते रहने चाहिए।"}]]}]]}],["$","article","07",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"07"}],["$","p",null,{"children":"स्वचालन"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"रोज़मर्रा के काम को एक लय दें।"}],["$","p",null,{"children":"एक बार, अंतराल पर, रोज़ या साप्ताहिक काम समय क्षेत्र के साथ तय करें और इतिहास देखें। काम Artemis खुले रहने पर चलता है; निष्पादन मोड के कार्यक्रमों के लिए स्पष्ट अनुमति चाहिए।"}]]}]]}],"$Lc","$Ld","$Le"]}],"$Lf","$L10","$L11"]}],"$L12"]
