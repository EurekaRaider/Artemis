c:["$","article","08",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"08"}],["$","p",null,{"children":"प्लगइन और सेवाएँ"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"काम को जितना चाहिए, उतना जोड़ें।"}],["$","p",null,{"children":"प्लगइन, कौशल, कनेक्टर और MCP एक जगह सँभालें। सर्वर खोजें, खाते जोड़ें या भरोसेमंद बाज़ार जोड़ें। बाहरी बाज़ार डिफ़ॉल्ट रूप से नहीं लाए जाते।"}]]}]]}]
d:["$","article","09",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"09"}],["$","p",null,{"children":"मॉडल और उपयोग"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"अपना संतुलन खोजें।"}],["$","p",null,{"children":"हर बातचीत का मॉडल चुनें, अनुकूल प्रदाता जोड़ें और टोकन व कैश उपयोग देखें। Ultra मोड जटिल काम में गहरा तर्क और समानांतर काम देता है, लेकिन उपयोग बढ़ता है।"}]]}]]}]
e:["$","article","10",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"10"}],["$","p",null,{"children":"स्मृति और भाषा"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"कम दोहराव। अधिक निरंतरता।"}],["$","p",null,{"children":"प्रोजेक्ट की जानकारी और निर्देश दोबारा इस्तेमाल करें। कौशल और टूल सेटिंग चुनकर आयात करें, बिना चुपचाप क्रेडेंशियल कॉपी किए। 14 भाषाएँ, सिस्टम भाषा और अरबी का दाएँ से बाएँ लेआउट उपलब्ध हैं।"}]]}]]}]
