1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"मुख्य सामग्री पर जाएँ"}],["$","$Lb",null,{"locale":"hi","copy":{"home":"परिचय","features":"सुविधाएँ","security":"गोपनीयता और नियंत्रण","download":"डाउनलोड","menu":"नेविगेशन खोलें","closeMenu":"नेविगेशन बंद करें","primaryLabel":"मुख्य नेविगेशन","mobileLabel":"मोबाइल नेविगेशन","homeLabel":"Artemis का मुखपृष्ठ","languageLabel":"भाषा चुनें","skipLink":"मुख्य सामग्री पर जाएँ"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"प्रभावी: 19 सितंबर 2026 · संचालक: Eureka Raider"}],["$","h1",null,{"children":"गोपनीयता नीति"}],["$","p",null,{"children":"कार्यस्थल आपके उपकरण पर रहता है। खाते और ऑनलाइन मॉडल इस्तेमाल करने में चुनी सेवाएँ भी शामिल होती हैं। यह नीति इन सीमाओं को समझाती है।"}]]}],["$","article",null,{"className":"section-shell legal-document","aria-label":"गोपनीयता नीति","children":[[["$","section","1. दायरा और संचालक",{"children":[["$","h2",null,{"children":"1. दायरा और संचालक"}],[["$","p","Eureka Raider AI कार्यस्थल Artemis और यह वेबसाइट प्रदान करता है। नीति Artemis, Google एकीकरण और सहायता के माध्यम से सूचना प्रबंधन पर लागू है। तीसरे पक्ष की अपनी नीतियाँ भी लागू होती हैं।",{"children":"Eureka Raider AI कार्यस्थल Artemis और यह वेबसाइट प्रदान करता है। नीति Artemis, Google एकीकरण और सहायता के माध्यम से सूचना प्रबंधन पर लागू है। तीसरे पक्ष की अपनी नीतियाँ भी लागू होती हैं।"}]]]}],["$","section","2. पहुँच योग्य जानकारी",{"children":[["$","h2",null,{"children":"2. पहुँच योग्य जानकारी"}],[["$","p","आपके दिए या अधिकृत निर्देश, फ़ाइलें, प्रोजेक्ट, टूल परिणाम और बातचीत संसाधित होते हैं। चुनी सेवाओं के लिए मॉडल सेटिंग और जुड़े खातों के क्रेडेंशियल चाहिए।",{"children":"आपके दिए या अधिकृत निर्देश, फ़ाइलें, प्रोजेक्ट, टूल परिणाम और बातचीत संसाधित होते हैं। चुनी सेवाओं के लिए मॉडल सेटिंग और जुड़े खातों के क्रेडेंशियल चाहिए।"}],["$","p","Google जोड़ने पर खाते की पहचान, ईमेल और प्रोफ़ाइल ली जाती है। कनेक्टर और अनुमति के अनुसार Gmail का पाठ, हेडर, प्राप्तकर्ता, अटैचमेंट, ड्राफ़्ट और लेबल; दस्तावेज़, शीट और प्रस्तुतियों सहित Google Drive की सामग्री और मेटाडेटा; तथा Google Calendar के कैलेंडर, घटनाएँ, प्रतिभागी और उपलब्धता तक पहुँच हो सकती है। Google सहमति स्क्रीन माँगी गई अनुमतियाँ दिखाती है।",{"children":"Google जोड़ने पर खाते की पहचान, ईमेल और प्रोफ़ाइल ली जाती है। कनेक्टर और अनुमति के अनुसार Gmail का पाठ, हेडर, प्राप्तकर्ता, अटैचमेंट, ड्राफ़्ट और लेबल; दस्तावेज़, शीट और प्रस्तुतियों सहित Google Drive की सामग्री और मेटाडेटा; तथा Google Calendar के कैलेंडर, घटनाएँ, प्रतिभागी और उपलब्धता तक पहुँच हो सकती है। Google सहमति स्क्रीन माँगी गई अनुमतियाँ दिखाती है।"}]]]}],["$","section","3. Google अनुमतियों का उद्देश्य",{"children":[["$","h2",null,{"children":"3. Google अनुमतियों का उद्देश्य"}],[["$","p","Gmail अनुरोध पर खोजने, पढ़ने, ड्राफ़्ट बनाने, भेजने और व्यवस्थित करने के लिए है। Drive फ़ाइलें खोजने, पढ़ने, बनाने और बदलने के लिए; Calendar कार्यक्रम देखने, बनाने, बदलने और हटाने के लिए है। काम उपलब्ध टूल और निर्देशों पर निर्भर है।",{"children":"Gmail अनुरोध पर खोजने, पढ़ने, ड्राफ़्ट बनाने, भेजने और व्यवस्थित करने के लिए है। Drive फ़ाइलें खोजने, पढ़ने, बनाने और बदलने के लिए; Calendar कार्यक्रम देखने, बनाने, बदलने और हटाने के लिए है। काम उपलब्ध टूल और निर्देशों पर निर्भर है।"}],["$","p","कनेक्शन वैकल्पिक है। Google डेटा अनुरोधित सुविधाओं के लिए है, विज्ञापन, विज्ञापन प्रोफ़ाइल या ऋण निर्णय के लिए नहीं; इसे बेचा नहीं जाता।",{"children":"कनेक्शन वैकल्पिक है। Google डेटा अनुरोधित सुविधाओं के लिए है, विज्ञापन, विज्ञापन प्रोफ़ाइल या ऋण निर्णय के लिए नहीं; इसे बेचा नहीं जाता।"}]]]}],["$","section","4. मॉडल और अन्य प्राप्तकर्ता",{"children":["$Lc",["$Ld","$Le","$Lf"]]}],"$L10","$L11","$L12","$L13","$L14"],"$L15","$L16","$L17"]}]]}],"$L18"]
