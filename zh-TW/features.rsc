e:["$","dl",null,{"className":"agent-settings","children":[["$","div","專屬指引",{"children":[["$","dt",null,{"children":"專屬指引"}],["$","dd",null,{"children":"明確職責、工作方法與交付要求。"}]]}],["$","div","模型與思考",{"children":[["$","dt",null,{"children":"模型與思考"}],["$","dd",null,{"children":"指定模型與思考深度，或繼承目前對話。"}]]}],["$","div","工具與專案",{"children":[["$","dt",null,{"children":"工具與專案"}],["$","dd",null,{"children":"選擇可用工具，設定適用的專案範圍。"}]]}],["$","div","呼叫方式",{"children":[["$","dt",null,{"children":"呼叫方式"}],["$","dd",null,{"children":"在桌面用 @ 指定，或允許主智慧體依任務自動選擇。"}]]}]]}]
f:["$","div",null,{"className":"agent-roles","children":[["$","p",null,{"className":"journey-label","children":"你的角色，可以這樣分工"}],[["$","article","研究員",{"children":[["$","span",null,{"className":"role-monogram","aria-hidden":"true","children":["0",1]}],["$","div",null,{"children":[["$","h3",null,{"children":"研究員"}],["$","p",null,{"children":"整理資料，保留來源，提煉有依據的結論。"}]]}],["$","span",null,{"className":"role-mention","aria-hidden":"true","children":"@"}]]}],["$","article","審閱員",{"children":[["$","span",null,{"className":"role-monogram","aria-hidden":"true","children":["0",2]}],["$","div",null,{"children":[["$","h3",null,{"children":"審閱員"}],["$","p",null,{"children":"檢查論據，發現遺漏，提出具體修改建議。"}]]}],["$","span",null,{"className":"role-mention","aria-hidden":"true","children":"@"}]]}]],["$","p",null,{"className":"roles-caption","children":"同一個角色，可以參與不同任務。"}]]}]
10:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"能力，放在一起更有用"}],["$","h2",null,{"children":"一套方法，\n兩種協作方式。"}],["$","p",null,{"children":"自訂智慧體提供專長，Agent Team 組織本機分工，IM 群組連接不同成員的 Artemis。"}]]}],["$","$L14",null,{"label":"選擇協作方式","modes":[{"tab":"與 Agent Team 配合","title":"讓你的專業角色，組成一支團隊。","body":"把研究與審閱分成獨立任務，交給不同的自訂智慧體並行處理。主智慧體協調進度、整理成果，你可以在團隊面板查看每個角色的工作。","steps":[{"title":"拆分任務","body":"明確每個部分要完成什麼。"},{"title":"呼叫專業角色","body":"透過 @ 任務區塊或已允許的自動呼叫，選用自訂智慧體。"},{"title":"並行推進","body":"在 Agent Team 中查看分工、狀態與訊息。"},{"title":"彙整成果","body":"把各個角色的結果帶回目前任務。"}],"alt":"Artemis Agent Team 面板中的並行任務與成員進度"},{"tab":"與 IM 群組協作配合","title":"群組裡交代一件事，背後是一支隊伍。","body":"為本機角色開啟自動呼叫後，群組任務到達對應的 Artemis，主智慧體便能依專案範圍選用這些角色。每位成員的電腦負責自己的部分，成果回到共同的對話。","steps":[{"title":"群組裡發起","body":"向已授權的機器人交代目標。"},{"title":"定向分派","body":"把合適的工作交給對應成員的 Artemis。"},{"title":"本機分工","body":"主智慧體呼叫可用的專業角色，組織本機團隊。"},{"title":"回到群組裡","body":"彙整成果並回覆原請求者，繼續協作。"}],"alt":"Artemis 原生 IM 群組協作與成員任務"}],"rtl":false}]]}]}]
11:["$","section",null,{"className":"section-shell supporting-features","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"完整的桌面工作空間"}],["$","h2",null,{"children":"協作之外，\n完成工作的工具也在。"}]]}],["$","div",null,{"className":"supporting-grid","children":[["$","article","01",{"children":[["$","p",null,{"className":"eyebrow","children":"專案與對話"}],["$","h3",null,{"children":"讓思路，有跡可循。"}],["$","p",null,{"children":"儲存、搜尋、封存和分支對話。專案任務圍繞本機檔案展開，臨時對話容納獨立工作。目標模式支援持續推進較長任務，也可設定 Token 預算。"}]]}],["$","article","02",{"children":[["$","p",null,{"className":"eyebrow","children":"檔案與文件"}],["$","h3",null,{"children":"交付可以繼續使用的成果。"}],["$","p",null,{"children":"閱讀和編輯檔案，預覽 Markdown，使用內建外掛建立 Word、Excel、PowerPoint 或 PDF 內容。支援基本內容處理，不保證完整保留巨集、動畫或複雜排版。"}]]}],["$","article","03",{"children":[["$","p",null,{"className":"eyebrow","children":"程式與審閱"}],["$","h3",null,{"children":"交付之前，讀懂每一處修改。"}],["$","p",null,{"children":"比較上一輪、暫存區或分支的變更，加入行內評論，按區塊暫存。可以在本機目錄工作，也可主動切換到隔離的工作樹。"}]]}],["$","article","04",{"children":[["$","p",null,{"className":"eyebrow","children":"終端機與瀏覽器"}],["$","h3",null,{"children":"把驗證，放在工作旁邊。"}],["$","p",null,{"children":"執行真正的終端機，開啟網頁，在對話旁檢查檔案。內建瀏覽器將網頁與桌面介面及本機檔案隔離。"}]]}],["$","article","07",{"children":[["$","p",null,{"className":"eyebrow","children":"自動化"}],["$","h3",null,{"children":"讓日常工作，按時到來。"}],["$","p",null,{"children":"設定單次、間隔、每日或每週任務，指定時區並查看執行紀錄。任務在 Artemis 開啟時執行；執行模式的自動化需要明確授權。"}]]}],["$","article","08",{"children":[["$","p",null,{"className":"eyebrow","children":"外掛與連接服務"}],["$","h3",null,{"children":"需要什麼，再加入什麼。"}],["$","p",null,{"children":"統一管理外掛、技能、連接器和 MCP。尋找 MCP 服務、連接帳戶，或加入你信任的市集。外部市集不會預設擷取。"}]]}],["$","article","09",{"children":[["$","p",null,{"className":"eyebrow","children":"模型與用量"}],["$","h3",null,{"children":"找到適合自己的平衡。"}],["$","p",null,{"children":"為每段對話選擇模型，接入相容服務，查看 Token 與快取用量。Ultra 模式為複雜任務提供更深入的思考與平行協作，同時消耗更多用量。"}]]}],["$","article","10",{"children":[["$","p",null,{"className":"eyebrow","children":"記憶與語言"}],["$","h3",null,{"children":"少些重複，多些延續。"}],["$","p",null,{"children":"保留可重複使用的專案經驗和指引，按類別匯入技能與工具設定，不會默默複製憑證。支援 14 種語言、跟隨系統語言，以及阿拉伯語由右至左的介面。"}]]}]]}]]}]
