e:["$","section",null,{"id":"custom-agents","className":"section-shell feature-story agents-story","children":[["$","div",null,{"className":"story-copy","children":[["$","p",null,{"className":"eyebrow","children":"사용자 지정 에이전트"}],["$","h2",null,{"children":"나만의 방식을,\n믿고 맡길 역할로."}],["$","p",null,{"children":"조사, 검토, 글쓰기를 위한 전용 에이전트를 만드세요. 역할과 결과물 기준을 한 번 정하면 선택한 프로젝트에서 반복해서 호출할 수 있습니다."}],["$","dl",null,{"className":"agent-settings","children":[["$","div","전용 지침",{"children":[["$","dt",null,{"children":"전용 지침"}],["$","dd",null,{"children":"역할, 작업 방식, 결과물 기준을 정합니다."}]]}],["$","div","모델과 추론",{"children":[["$","dt",null,{"children":"모델과 추론"}],["$","dd",null,{"children":"모델과 추론 수준을 지정하거나 현재 대화 설정을 따릅니다."}]]}],["$","div","도구와 프로젝트",{"children":[["$","dt",null,{"children":"도구와 프로젝트"}],["$","dd",null,{"children":"사용할 도구와 역할이 적용되는 프로젝트를 선택합니다."}]]}],["$","div","호출 방식",{"children":[["$","dt",null,{"children":"호출 방식"}],["$","dd",null,{"children":"데스크톱에서 @로 지정하거나 주 에이전트의 자동 선택을 허용합니다."}]]}]]}]]}],["$","div",null,{"className":"agent-roles","children":[["$","p",null,{"className":"journey-label","children":"이런 역할로 나눌 수 있어요"}],[["$","article","조사 담당",{"children":[["$","span",null,{"className":"role-monogram","aria-hidden":"true","children":["0",1]}],["$","div",null,{"children":[["$","h3",null,{"children":"조사 담당"}],["$","p",null,{"children":"자료와 출처를 정리하고 근거 있는 결론을 도출합니다."}]]}],["$","span",null,{"className":"role-mention","aria-hidden":"true","children":"@"}]]}],["$","article","검토 담당",{"children":[["$","span",null,{"className":"role-monogram","aria-hidden":"true","children":["0",2]}],["$","div",null,{"children":[["$","h3",null,{"children":"검토 담당"}],["$","p",null,{"children":"논거와 누락을 확인하고 구체적인 개선안을 제시합니다."}]]}],["$","span",null,{"className":"role-mention","aria-hidden":"true","children":"@"}]]}]],["$","p",null,{"className":"roles-caption","children":"하나의 역할이 여러 작업에 참여할 수 있습니다."}]]}]]}]
f:["$","section",null,{"id":"work-together","className":"together-story","children":["$","div",null,{"className":"section-shell","children":[["$","div",null,{"className":"story-copy together-intro","children":[["$","p",null,{"className":"eyebrow","children":"함께 쓸 때 넓어지는 가능성"}],["$","h2",null,{"children":"하나의 방식,\n두 가지 협업."}],["$","p",null,{"children":"사용자 지정 에이전트가 전문성을 더하고, Agent Team이 한 컴퓨터의 분담을 조율합니다. IM 그룹은 각자의 Artemis를 연결합니다."}]]}],["$","$L13",null,{"label":"협업 방식 선택","modes":[{"tab":"Agent Team과 함께","title":"전문 역할을 하나의 팀으로.","body":"조사와 검토를 독립된 작업으로 나눠 사용자 지정 에이전트가 병렬로 진행합니다. 주 에이전트가 진도를 조율하고 결과를 모으며, 팀 패널에서 각 역할을 확인할 수 있습니다.","steps":[{"title":"작업 나누기","body":"각 부분에서 필요한 결과를 정합니다."},{"title":"전문 역할 호출","body":"@ 작업 블록이나 허용한 자동 호출을 사용합니다."},{"title":"병렬로 진행","body":"Agent Team에서 담당, 상태, 메시지를 확인합니다."},{"title":"결과 모으기","body":"각 역할의 결과를 현재 작업으로 가져옵니다."}],"alt":"병렬 작업과 멤버 진행 상황을 보여 주는 Artemis Agent Team"},{"tab":"IM 그룹 협업과 함께","title":"그룹의 요청 하나, 뒤에서 움직이는 팀.","body":"로컬 역할의 자동 호출을 켜 두면, 그룹 작업이 해당 Artemis에 도착했을 때 주 에이전트가 프로젝트 범위 안에서 역할을 선택합니다. 각자의 컴퓨터가 맡은 부분을 처리하고 공동 대화로 결과를 돌려줍니다.","steps":[{"title":"그룹에서 요청","body":"허용된 봇에 목표를 전달합니다."},{"title":"멤버에게 할당","body":"적합한 작업을 해당 멤버의 Artemis에 맡깁니다."},{"title":"로컬에서 분담","body":"주 에이전트가 사용할 수 있는 전문 역할로 팀을 구성합니다."},{"title":"그룹에 답장","body":"결과를 모아 요청자에게 답하고 협업을 이어갑니다."}],"alt":"Artemis 네이티브 IM 그룹 협업과 멤버 작업"}],"locale":"ko","rtl":false}]]}]}]
