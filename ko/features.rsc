1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"본문으로 이동"}],["$","$Lb",null,{"locale":"ko","copy":{"home":"개요","features":"기능","security":"개인정보와 제어","download":"다운로드","menu":"탐색 열기","closeMenu":"탐색 닫기","primaryLabel":"주 탐색","mobileLabel":"모바일 탐색","homeLabel":"Artemis 홈","languageLabel":"언어 선택","skipLink":"본문으로 이동"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"자세히 알아보기"}],["$","h1",null,{"children":"첫 생각에서 완성된 작업까지."}],["$","p",null,{"children":"계속 이어지는 대화와, 생각을 유용한 결과로 바꾸는 도구."}]]}],["$","section",null,{"className":"section-shell feature-list","children":[["$","article","01",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"01"}],["$","p",null,{"children":"프로젝트와 대화"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"작업의 흐름을 이어 가세요."}],["$","p",null,{"children":"대화를 저장, 검색, 보관하고 분기하세요. 프로젝트 작업은 로컬 파일과 이어지고 임시 대화는 독립적인 작업 공간을 제공합니다. 목표 기능으로 긴 작업을 이어 가며 토큰 예산도 설정할 수 있습니다."}]]}]]}],["$","article","02",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"02"}],["$","p",null,{"children":"파일과 문서"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"계속 활용할 수 있는 결과를."}],["$","p",null,{"children":"파일을 읽고 편집하고 Markdown을 미리 보세요. 기본 플러그인으로 Word, Excel, PowerPoint, PDF를 만듭니다. 기본 내용을 지원하며 매크로, 애니메이션, 복잡한 배치의 완전한 보존은 보장하지 않습니다."}]]}]]}],["$","article","03",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"03"}],["$","p",null,{"children":"코드와 검토"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"전달하기 전에 변경을 이해하세요."}],["$","p",null,{"children":"지난 턴, 스테이징된 변경, 브랜치를 비교하고 줄별 의견과 부분 스테이징을 활용하세요. 로컬 체크아웃이나 명시적으로 선택한 분리된 워크트리에서 작업할 수 있습니다."}]]}]]}],["$","article","04",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"04"}],["$","p",null,{"children":"터미널과 브라우저"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"확인할 근거를 가까이."}],["$","p",null,{"children":"실제 터미널, 웹페이지와 파일을 대화 옆에서 확인하세요. 브라우저의 웹 콘텐츠는 데스크톱 API 및 로컬 파일과 분리됩니다."}]]}]]}],["$","article","05",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"05"}],["$","p",null,{"children":"에이전트 팀"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"각 부분에 집중할 기회를."}],["$","p",null,{"children":"독립적인 작업을 여러 에이전트가 병렬로 조사합니다. 전용 지침, 선호 모델과 허용 도구를 가진 전문 역할을 만들고 @로 호출해 진행 상황을 확인하세요."}]]}]]}],["$","article","06",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"06"}],["$","p",null,{"children":"메시지와 협업"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"대화가 있는 곳에서 일을 이어 가세요."}],["$","p",null,{"children":"WeCom, Feishu / Lark, Slack 개인 대화로 일을 맡기세요. Slack과 Feishu / Lark 그룹에서는 각자 연결한 봇이 허용 범위 안에서 협업하고 요청자에게 결과를 돌려줍니다. 컴퓨터와 Artemis가 실행 중이어야 합니다."}]]}]]}],["$","article","07",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"07"}],["$","p",null,{"children":"자동화"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"일상적인 일에 규칙적인 시간을."}],["$","p",null,{"children":"일회성, 일정 간격, 매일 또는 매주 작업을 시간대와 함께 예약하고 이력을 확인하세요. Artemis가 켜진 동안 실행되며 실행 모드 자동화에는 명시적인 승인이 필요합니다."}]]}]]}],["$","article","08",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"08"}],["$","p",null,{"children":"플러그인과 서비스"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"필요한 기능만 더하세요."}],["$","p",null,{"children":"플러그인, 스킬, 커넥터와 MCP를 한곳에서 관리하세요. MCP 서버를 찾고 계정을 연결하거나 신뢰하는 마켓을 추가할 수 있습니다. 외부 마켓은 기본으로 가져오지 않습니다."}]]}]]}],["$","article","09",{"className":"feature-row","children":[["$","div",null,{"className":"feature-index","children":[["$","span",null,{"children":"09"}],["$","p",null,{"children":"모델과 사용량"}]]}],["$","div",null,{"className":"feature-copy","children":[["$","h2",null,{"children":"나에게 맞는 균형을."}],["$","p",null,{"children":"대화별 모델과 호환 공급자를 선택하고 토큰 및 캐시 사용량을 확인하세요. Ultra 모드는 복잡한 작업에 깊은 추론과 병렬 작업을 제공하며 사용량도 늘어납니다."}]]}]]}],["$","article","10",{"className":"feature-row","children":["$Lc","$Ld"]}]]}],"$Le","$Lf","$L10"]}],"$L11"]
