{
  "name": "@artemis/agent-host",
  "version": "1.7.8",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builtin-models": {
      "types": "./dist/models/builtin-models.d.ts",
      "import": "./dist/models/builtin-models.js"
    },
    "./custom-agent-capabilities": {
      "types": "./dist/policy/custom-agent-capabilities.d.ts",
      "import": "./dist/policy/custom-agent-capabilities.js"
    },
    "./turn-prompt": {
      "types": "./dist/context/turn-prompt.d.ts",
      "import": "./dist/context/turn-prompt.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.84",
    "@artemis/platform": "1.7.8",
    "@artemis/protocol": "1.7.8",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@sinclair/typebox": "0.34.52",
    "ai": "6.0.168",
    "undici": "7.29.1"
  }
}
