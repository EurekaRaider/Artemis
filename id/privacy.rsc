1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Langsung ke konten"}],["$","$Lb",null,{"locale":"id","copy":{"home":"Ikhtisar","features":"Fitur","security":"Privasi dan kendali","download":"Unduh","menu":"Buka navigasi","closeMenu":"Tutup navigasi","primaryLabel":"Navigasi utama","mobileLabel":"Navigasi seluler","homeLabel":"Beranda Artemis","languageLabel":"Pilih bahasa","skipLink":"Langsung ke konten"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"Berlaku 19 September 2026 · Operator: Eureka Raider"}],["$","h1",null,{"children":"Kebijakan privasi"}],["$","p",null,{"children":"Ruang kerja tersimpan di perangkat. Akun dan model daring juga melibatkan layanan pilihan Anda. Kebijakan ini menjelaskan batasnya."}]]}],["$","article",null,{"className":"section-shell legal-document","aria-label":"Kebijakan privasi","children":[[["$","section","1. Cakupan dan operator",{"children":[["$","h2",null,{"children":"1. Cakupan dan operator"}],[["$","p","Eureka Raider menyediakan ruang kerja AI Artemis dan situs ini. Kebijakan mencakup pengolahan informasi melalui Artemis, integrasi Google, dan dukungan. Pihak ketiga juga memiliki kebijakan sendiri.",{"children":"Eureka Raider menyediakan ruang kerja AI Artemis dan situs ini. Kebijakan mencakup pengolahan informasi melalui Artemis, integrasi Google, dan dukungan. Pihak ketiga juga memiliki kebijakan sendiri."}]]]}],["$","section","2. Informasi yang diakses",{"children":[["$","h2",null,{"children":"2. Informasi yang diakses"}],[["$","p","Kami memproses instruksi, berkas, proyek, hasil alat, dan percakapan yang diberikan atau diizinkan. Konfigurasi model dan kredensial akun diperlukan untuk layanan yang dipilih.",{"children":"Kami memproses instruksi, berkas, proyek, hasil alat, dan percakapan yang diberikan atau diizinkan. Konfigurasi model dan kredensial akun diperlukan untuk layanan yang dipilih."}],["$","p","Saat Google terhubung, pengenal akun, email, dan profil digunakan untuk mengenali akun. Sesuai konektor dan izin: isi, header, penerima, lampiran, draf, dan label Gmail; isi serta metadata Drive termasuk dokumen, spreadsheet, dan presentasi; kalender, acara, peserta, dan ketersediaan Calendar. Layar persetujuan Google menampilkan izin yang diminta.",{"children":"Saat Google terhubung, pengenal akun, email, dan profil digunakan untuk mengenali akun. Sesuai konektor dan izin: isi, header, penerima, lampiran, draf, dan label Gmail; isi serta metadata Drive termasuk dokumen, spreadsheet, dan presentasi; kalender, acara, peserta, dan ketersediaan Calendar. Layar persetujuan Google menampilkan izin yang diminta."}]]]}],["$","section","3. Tujuan izin Google",{"children":[["$","h2",null,{"children":"3. Tujuan izin Google"}],[["$","p","Gmail mendukung pencarian, membaca, menulis, mengirim, dan menata pesan sesuai permintaan. Drive untuk mencari, membaca, membuat, dan memperbarui berkas; Calendar untuk memeriksa, membuat, memperbarui, atau menghapus acara. Tindakan bergantung pada alat dan instruksi Anda.",{"children":"Gmail mendukung pencarian, membaca, menulis, mengirim, dan menata pesan sesuai permintaan. Drive untuk mencari, membaca, membuat, dan memperbarui berkas; Calendar untuk memeriksa, membuat, memperbarui, atau menghapus acara. Tindakan bergantung pada alat dan instruksi Anda."}],["$","p","Koneksi opsional. Data Google digunakan untuk fitur yang diminta, bukan iklan, profil iklan, atau keputusan kredit, dan tidak dijual.",{"children":"Koneksi opsional. Data Google digunakan untuk fitur yang diminta, bukan iklan, profil iklan, atau keputusan kredit, dan tidak dijual."}]]]}],"$Lc","$Ld","$Le","$Lf","$L10","$L11"],"$L12","$L13","$L14"]}]]}],"$L15"]
16:I["9fb86276be8f",[],"default",1]
c:["$","section","4. Model dan penerima lain",{"children":[["$","h2",null,{"children":"4. Model dan penerima lain"}],[["$","p","Pesan, berkas, kalender, dan hasil Google yang relevan dapat masuk ke percakapan yang dikirim kepada penyedia AI yang dikonfigurasi. Penyimpanan lokal bukan berarti semua pemrosesan lokal. Pilih penyedia dan retensi yang sesuai untuk data sensitif.",{"children":"Pesan, berkas, kalender, dan hasil Google yang relevan dapat masuk ke percakapan yang dikirim kepada penyedia AI yang dikonfigurasi. Penyimpanan lokal bukan berarti semua pemrosesan lokal. Pilih penyedia dan retensi yang sesuai untuk data sensitif."}],["$","p","Alat dan plugin menerima data yang perlu untuk tindakan berizin. Mengirim, membagikan, atau memublikasikan juga mengungkap isi kepada penerima pilihan. Perangkat berkomunikasi dengan Google dan layanan yang diatur; situs tidak menerima token Google.",{"children":"Alat dan plugin menerima data yang perlu untuk tindakan berizin. Mengirim, membagikan, atau memublikasikan juga mengungkap isi kepada penerima pilihan. Perangkat berkomunikasi dengan Google dan layanan yang diatur; situs tidak menerima token Google."}],["$","p","Data Google hanya ditransfer dengan persetujuan untuk fitur yang diminta, kebutuhan keamanan, kewajiban hukum, atau perpindahan kepemilikan dengan persetujuan tegas sebelumnya.",{"children":"Data Google hanya ditransfer dengan persetujuan untuk fitur yang diminta, kebutuhan keamanan, kewajiban hukum, atau perpindahan kepemilikan dengan persetujuan tegas sebelumnya."}]]]}]
d:["$","section","5. API Google dan penggunaan terbatas",{"children":[["$","h2",null,{"children":"5. API Google dan penggunaan terbatas"}],[["$","p","Penggunaan dan transfer mengikuti Google API Services User Data Policy beserta persyaratan Limited Use.",{"children":"Penggunaan dan transfer mengikuti Google API Services User Data Policy beserta persyaratan Limited Use."}],["$","p","Data Google tidak dipakai mengembangkan, meningkatkan, atau melatih model AI umum atau pembelajaran mesin. Pemrosesan untuk menjawab berbeda dari pelatihan. Gunakan penyedia dan pengaturan yang mematuhi batas ini.",{"children":"Data Google tidak dipakai mengembangkan, meningkatkan, atau melatih model AI umum atau pembelajaran mesin. Pemrosesan untuk menjawab berbeda dari pelatihan. Gunakan penyedia dan pengaturan yang mematuhi batas ini."}],["$","p","Kami tidak rutin membaca data Google. Akses manusia dibatasi pada izin tegas untuk data tertentu, investigasi keamanan yang perlu, kewajiban hukum, atau operasi internal agregat yang diizinkan Google.",{"children":"Kami tidak rutin membaca data Google. Akses manusia dibatasi pada izin tegas untuk data tertentu, investigasi keamanan yang perlu, kewajiban hukum, atau operasi internal agregat yang diizinkan Google."}]]]}]
e:["$","section","6. Penyimpanan dan keamanan",{"children":[["$","h2",null,{"children":"6. Penyimpanan dan keamanan"}],[["$","p","Ruang kerja dan percakapan berada di perangkat. Kredensial Google dienkripsi dengan perlindungan sistem; jika tidak tersedia, penyimpanan ditolak. Ini tidak mengenkripsi semua berkas dan percakapan. Lindungi perangkat, cadangan, dan akun.",{"children":"Ruang kerja dan percakapan berada di perangkat. Kredensial Google dienkripsi dengan perlindungan sistem; jika tidak tersedia, penyimpanan ditolak. Ini tidak mengenkripsi semua berkas dan percakapan. Lindungi perangkat, cadangan, dan akun."}],["$","p","Kredensial tetap ada hingga pemutusan atau penghapusan data lokal terkait. Percakapan dan hasil dapat tetap ada sampai Anda hapus. Penyedia menerapkan retensi sendiri; kami tidak menjanjikan jangka tetap bagi salinannya.",{"children":"Kredensial tetap ada hingga pemutusan atau penghapusan data lokal terkait. Percakapan dan hasil dapat tetap ada sampai Anda hapus. Penyedia menerapkan retensi sendiri; kami tidak menjanjikan jangka tetap bagi salinannya."}]]]}]
f:["$","section","7. Putus koneksi, cabut izin, dan hapus",{"children":[["$","h2",null,{"children":"7. Putus koneksi, cabut izin, dan hapus"}],[["$","p","Memutus Google di Artemis menghapus kredensial lokal tersimpan. Untuk mencabut akses Google, hapus Artemis dari koneksi pihak ketiga akun Google. Pemutusan lokal saja tidak mencabut izin Google atau menghapus isi tugas sebelumnya.",{"children":"Memutus Google di Artemis menghapus kredensial lokal tersimpan. Untuk mencabut akses Google, hapus Artemis dari koneksi pihak ketiga akun Google. Pemutusan lokal saja tidak mencabut izin Google atau menghapus isi tugas sebelumnya."}],["$","p","Hapus percakapan, ekspor, dan data tidak diperlukan, serta cadangan secara terpisah. Memutus koneksi tidak menghapus data asli Gmail, Drive, atau Calendar. Kelola di Google dan minta penyedia model atau plugin menghapus salinannya.",{"children":"Hapus percakapan, ekspor, dan data tidak diperlukan, serta cadangan secara terpisah. Memutus koneksi tidak menghapus data asli Gmail, Drive, atau Calendar. Kelola di Google dan minta penyedia model atau plugin menghapus salinannya."}],["$","p","Hubungi dukungan untuk akses, koreksi, atau penghapusan. Kami bisa menangani informasi yang dikirim ke dukungan, tetapi tidak menghapus jarak jauh berkas yang hanya ada di perangkat. Jangan kirim kata sandi, kunci API, token, atau email sensitif ke milis dukungan.",{"children":"Hubungi dukungan untuk akses, koreksi, atau penghapusan. Kami bisa menangani informasi yang dikirim ke dukungan, tetapi tidak menghapus jarak jauh berkas yang hanya ada di perangkat. Jangan kirim kata sandi, kunci API, token, atau email sensitif ke milis dukungan."}]]]}]
10:["$","section","8. Situs dan dukungan",{"children":[["$","h2",null,{"children":"8. Situs dan dukungan"}],[["$","p","Situs memakai GitHub Pages. Hosting dapat memproses IP, detail browser, dan informasi teknis untuk penyajian serta keamanan. Unduhan menggunakan hosting rilis GitHub.",{"children":"Situs memakai GitHub Pages. Hosting dapat memproses IP, detail browser, dan informasi teknis untuk penyajian serta keamanan. Unduhan menggunakan hosting rilis GitHub."}],["$","p","Situs memilih bahasa sesuai preferensi browser. Pilihan manual disimpan di penyimpanan lokal browser dan diprioritaskan. Anda dapat mengubahnya lewat menu bahasa atau menghapus data situs untuk menghilangkan pilihan tersimpan.",{"children":"Situs memilih bahasa sesuai preferensi browser. Pilihan manual disimpan di penyimpanan lokal browser dan diprioritaskan. Anda dapat mengubahnya lewat menu bahasa atau menghapus data situs untuk menghilangkan pilihan tersimpan."}],["$","p","Email dan informasi yang dikirim digunakan untuk menjawab. Alamat merupakan milis Google Groups; pesan diproses di sana dan mungkin terlihat oleh anggota. Bagikan seperlunya saja.",{"children":"Email dan informasi yang dikirim digunakan untuk menjawab. Alamat merupakan milis Google Groups; pesan diproses di sana dan mungkin terlihat oleh anggota. Bagikan seperlunya saja."}]]]}]
11:["$","section","9. Perubahan dan kontak",{"children":[["$","h2",null,{"children":"9. Perubahan dan kontak"}],[["$","p","Pembaruan dipublikasikan dengan tanggal baru. Penggunaan Google di luar izin sebelumnya akan dijelaskan dan memerlukan persetujuan terlebih dahulu. Hubungi Eureka Raider di bawah untuk privasi atau penghapusan.",{"children":"Pembaruan dipublikasikan dengan tanggal baru. Penggunaan Google di luar izin sebelumnya akan dijelaskan dan memerlukan persetujuan terlebih dahulu. Hubungi Eureka Raider di bawah untuk privasi atau penghapusan."}]]]}]
