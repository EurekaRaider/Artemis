15:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"className":"section-shell footer-grid","children":[["$","div",null,{"className":"footer-brand","children":[["$","a",null,{"className":"brand","href":"/id/","children":[["$","$L16",null,{"className":"brand-mark","src":"/images/artemis-icon.png","alt":"","width":"48","height":"48","unoptimized":true}],["$","span",null,{"children":"Artemis"}]]}],["$","p",null,{"children":"Sedikit lebih banyak ruang untuk yang berarti."}]]}],["$","div",null,{"className":"footer-column","children":[["$","h2",null,{"children":"Jelajahi Artemis"}],["$","a",null,{"href":"/id/","children":"Ikhtisar"}],["$","a",null,{"href":"/id/features/","children":"Fitur"}],["$","a",null,{"href":"/id/security/","children":"Privasi dan kendali"}],["$","a",null,{"href":"/id/download/","children":"Unduh"}]]}],["$","div",null,{"className":"footer-column","children":[["$","h2",null,{"children":"Privasi dan dukungan"}],["$","a",null,{"href":"/id/privacy/","children":"Kebijakan privasi"}],["$","a",null,{"href":"/id/terms/","children":"Ketentuan layanan"}],["$","a",null,{"href":"mailto:artemis-support@googlegroups.com","children":"Hubungi dukungan"}]]}]]}],["$","div",null,{"className":"section-shell footer-bottom","children":[["$","span",null,{"children":["© ",2026," Eureka Raider"]}],["$","span",null,{"children":"Untuk bekerja dengan penuh perhatian."}]]}]]}]
