11:["$","article","Alur kerja Anda, pada saat yang tepat.",{"children":[["$","h3",null,{"children":"Alur kerja Anda, pada saat yang tepat."}],["$","p",null,{"children":"Tinjau dan percayai Hooks perintah secara eksplisit di Pengaturan. Hooks berjalan di Work dan Codemode; Plan melewatinya. Plugin, Skills, dan MCP dikelola di pusat sumber daya."}]]}]
12:["$","article","Plugin interaktif",{"children":[["$","h3",null,{"children":"Plugin interaktif"}],["$","p",null,{"children":"Tambahkan panel dan alat terisolasi. Jika Design terpasang dan tersedia, buat dokumen, lihat riwayat versi, batalkan dan pulihkan perubahan. Berkas proyek memerlukan impor eksplisit."}]]}]
