1:[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Langsung ke konten"}],["$","$Lb",null,{"locale":"id","copy":{"home":"Ikhtisar","features":"Fitur","security":"Privasi dan kendali","download":"Unduh","menu":"Buka navigasi","closeMenu":"Tutup navigasi","primaryLabel":"Navigasi utama","mobileLabel":"Navigasi seluler","homeLabel":"Beranda Artemis","languageLabel":"Pilih bahasa","skipLink":"Langsung ke konten"}}],["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"page-hero section-shell","children":[["$","p",null,{"className":"eyebrow","children":"Berlaku 18 September 2026 · Operator: Eureka Raider"}],["$","h1",null,{"children":"Ketentuan layanan"}],["$","p",null,{"children":"Tanggung jawab saat menggunakan Artemis dan menghubungkan akun serta pekerjaan."}]]}],["$","article",null,{"className":"section-shell legal-document","aria-label":"Ketentuan layanan","children":[[["$","section","1. Persetujuan dan cakupan",{"children":[["$","h2",null,{"children":"1. Persetujuan dan cakupan"}],[["$","p","Berlaku untuk situs dan layanan desktop Artemis dari Eureka Raider. Penggunaan berarti setuju; jika tidak, hentikan. Anda harus cakap hukum dan berwenang bila mewakili organisasi. Lisensi perangkat lunak yang disertakan tetap mengatur hak yang diberikannya.",{"children":"Berlaku untuk situs dan layanan desktop Artemis dari Eureka Raider. Penggunaan berarti setuju; jika tidak, hentikan. Anda harus cakap hukum dan berwenang bila mewakili organisasi. Lisensi perangkat lunak yang disertakan tetap mengatur hak yang diberikannya."}]]]}],["$","section","2. Akun dan otorisasi",{"children":[["$","h2",null,{"children":"2. Akun dan otorisasi"}],[["$","p","Anda mengendalikan akun, model, alat, berkas, dan izin. Hubungkan hanya yang berhak digunakan, lindungi kredensial, dan periksa izin. Anda dapat memutus serta mencabut akses lewat penyedia.",{"children":"Anda mengendalikan akun, model, alat, berkas, dan izin. Hubungkan hanya yang berhak digunakan, lindungi kredensial, dan periksa izin. Anda dapat memutus serta mencabut akses lewat penyedia."}],["$","p","Anda bertanggung jawab atas instruksi dan pemeriksaan tindakan penting seperti pesan, perubahan berkas, perintah, dan kalender. Cadangkan data penting.",{"children":"Anda bertanggung jawab atas instruksi dan pemeriksaan tindakan penting seperti pesan, perubahan berkas, perintah, dan kalender. Cadangkan data penting."}]]]}],["$","section","3. Penggunaan yang dapat diterima",{"children":[["$","h2",null,{"children":"3. Penggunaan yang dapat diterima"}],[["$","p","Jangan gunakan untuk tindakan ilegal, akses tanpa izin, penipuan, malware, spam, pelanggaran hak, atau menghindari kontrol. Hormati privasi dan hak orang terkait, termasuk penerima dan kolaborator.",{"children":"Jangan gunakan untuk tindakan ilegal, akses tanpa izin, penipuan, malware, spam, pelanggaran hak, atau menghindari kontrol. Hormati privasi dan hak orang terkait, termasuk penerima dan kolaborator."}]]]}],["$","section","4. AI dan otomatisasi",{"children":[["$","h2",null,{"children":"4. AI dan otomatisasi"}],[["$","p","AI dapat keliru, tidak lengkap, atau usang. Periksa isi dan tindakan sebelum mengandalkannya. Tidak ada jaminan setiap instruksi diikuti atau hasil otomatisasi sesuai harapan. AI bukan pengganti nasihat profesional yang memenuhi syarat.",{"children":"AI dapat keliru, tidak lengkap, atau usang. Periksa isi dan tindakan sebelum mengandalkannya. Tidak ada jaminan setiap instruksi diikuti atau hasil otomatisasi sesuai harapan. AI bukan pengganti nasihat profesional yang memenuhi syarat."}]]]}],["$","section","5. Pihak ketiga dan biaya",{"children":["$Lc",["$Ld"]]}],"$Le","$Lf","$L10"],false,"$L11","$L12"]}]]}],"$L13"]
14:I["9fb86276be8f",[],"default",1]
c:["$","h2",null,{"children":"5. Pihak ketiga dan biaya"}]
d:["$","p","Google, penyedia model, plugin, dan layanan punya ketentuan, ketersediaan, kuota, serta kebijakan sendiri. Biaya menjadi tanggung jawab Anda. Koneksi Google bukan dukungan Google terhadap Artemis. Perubahan atau izin kedaluwarsa dapat memengaruhi fitur.",{"children":"Google, penyedia model, plugin, dan layanan punya ketentuan, ketersediaan, kuota, serta kebijakan sendiri. Biaya menjadi tanggung jawab Anda. Koneksi Google bukan dukungan Google terhadap Artemis. Perubahan atau izin kedaluwarsa dapat memengaruhi fitur."}]
e:["$","section","6. Konten dan privasi",{"children":[["$","h2",null,{"children":"6. Konten dan privasi"}],[["$","p","Hak konten tetap milik Anda; Anda mengizinkan pemrosesan yang perlu untuk fitur yang diminta tanpa memindahkan kepemilikan ke Eureka Raider. Baca kebijakan tentang akses, transfer, retensi, penghapusan, dan batas Google API.",{"children":"Hak konten tetap milik Anda; Anda mengizinkan pemrosesan yang perlu untuk fitur yang diminta tanpa memindahkan kepemilikan ke Eureka Raider. Baca kebijakan tentang akses, transfer, retensi, penghapusan, dan batas Google API."}]]]}]
f:["$","section","7. Ketersediaan dan tanggung jawab",{"children":[["$","h2",null,{"children":"7. Ketersediaan dan tanggung jawab"}],[["$","p","Sejauh hukum mengizinkan, Artemis tersedia apa adanya tanpa jaminan kesinambungan, kesesuaian tujuan, atau bebas kesalahan. Dalam batas yang sama, Eureka Raider tidak bertanggung jawab atas kerugian tidak langsung atau lanjutan, termasuk dari pihak ketiga atau tindakan AI yang tidak ditinjau. Tanggung jawab serta hak konsumen yang wajib tetap berlaku.",{"children":"Sejauh hukum mengizinkan, Artemis tersedia apa adanya tanpa jaminan kesinambungan, kesesuaian tujuan, atau bebas kesalahan. Dalam batas yang sama, Eureka Raider tidak bertanggung jawab atas kerugian tidak langsung atau lanjutan, termasuk dari pihak ketiga atau tindakan AI yang tidak ditinjau. Tanggung jawab serta hak konsumen yang wajib tetap berlaku."}]]]}]
10:["$","section","8. Pengakhiran dan perubahan",{"children":[["$","h2",null,{"children":"8. Pengakhiran dan perubahan"}],[["$","p","Anda dapat berhenti, memutus akun, dan menghapus data lokal kapan saja. Mencabut izin tidak otomatis menghapus berkas atau data yang telah dikirim. Kami dapat mengubah atau menghentikan fitur, atau membatasi layanan sendiri karena penyalahgunaan atau kewajiban hukum.",{"children":"Anda dapat berhenti, memutus akun, dan menghapus data lokal kapan saja. Mencabut izin tidak otomatis menghapus berkas atau data yang telah dikirim. Kami dapat mengubah atau menghentikan fitur, atau membatasi layanan sendiri karena penyalahgunaan atau kewajiban hukum."}],["$","p","Ketentuan baru diterbitkan di sini dengan tanggal; perubahan penting dijelaskan dalam ketentuan atau informasi rilis. Pertanyaan dapat dikirim ke kontak di bawah.",{"children":"Ketentuan baru diterbitkan di sini dengan tanggal; perubahan penting dijelaskan dalam ketentuan atau informasi rilis. Pertanyaan dapat dikirim ke kontak di bawah."}]]]}]
